rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn()
        && (profile().status == 'approved'
          || (!('status' in profile()) && profile().role != 'applicant'));
    }

    function isAdmin() {
      return approved() && profile().role in ['admin', 'superadmin'];
    }

    function isVolunteer() {
      return approved()
        && (
          (
            'volunteerAccess' in profile()
            && profile().volunteerAccess == true
            && (
              !('volunteerStatus' in profile())
              || profile().volunteerStatus == 'approved'
            )
          )
          || (
            !('volunteerAccess' in profile())
            && profile().role == 'volunteer'
          )
        );
    }

    match /disasterCases/{caseId}/{fileName} {
      allow write: if approved()
        && fileName.matches(request.auth.uid + '-.*')
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');

      allow read: if approved()
        && (isAdmin()
          || isVolunteer()
          || fileName.matches(request.auth.uid + '-.*'));
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if true;

      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Private government ID / live selfie / redacted LGU appointment evidence.
    // Never store public download URLs in Firestore; only applicant and programmer Super Admin can read.
    function isSuperAdmin() {
      return signedIn()
        && profile().role == 'superadmin'
        && profile().status == 'approved';
    }
    match /lguStaffEvidence/{uid}/{filename} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && profile().role == 'applicant'
        && profile().status == 'pending_review'
        && filename.matches('(front|back|selfie|lgu_proof)[.](jpg|png|webp)')
        && request.resource.size > 1024
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow get: if signedIn()
        && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}