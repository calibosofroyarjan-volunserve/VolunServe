PORT=10000

DIDIT_API_KEY=YOUR_PRIVATE_DIDIT_API_KEY
DIDIT_WORKFLOW_ID=YOUR_DIDIT_WORKFLOW_ID
DIDIT_WEBHOOK_SECRET=YOUR_PRIVATE_DIDIT_WEBHOOK_SECRET
DIDIT_ENVIRONMENT=sandbox
DIDIT_INTEGRATION_ENABLED=false
DIDIT_AUTO_VERIFY_ENABLED=false
# For a live rollout, use a Live Didit API key, Live workflow, and Live webhook secret.
# Keep sandbox results out of production resident profiles.


FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

VOLUNSERVE_CALLBACK_URL=