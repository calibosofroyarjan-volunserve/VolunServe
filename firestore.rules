        && request.resource.data.caseId.size() <= 160
        && request.resource.data.volunteerId == request.auth.uid
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 120
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() >= 2
        && request.resource.data.barangay.size() <= 120
        && request.resource.data.situationSummary is string
        && request.resource.data.situationSummary.size() >= 10
        && request.resource.data.situationSummary.size() <= 2000
        && request.resource.data.assistanceProvided is string
        && request.resource.data.assistanceProvided.size() >= 5
        && request.resource.data.assistanceProvided.size() <= 2000
        && request.resource.data.peopleHelped is int
        && request.resource.data.peopleHelped >= 0
        && request.resource.data.peopleHelped <= 10000
        && request.resource.data.remainingNeeds is list
        && request.resource.data.remainingNeeds.size() <= 12
        && request.resource.data.remainingNeedsNote is string
        && request.resource.data.remainingNeedsNote.size() <= 1500
        && request.resource.data.lguFollowUpRequired is bool
        && request.resource.data.evidenceUrls is list
        && request.resource.data.evidenceUrls.size() <= 6
        && request.resource.data.reportStatus == 'submitted'
        && request.resource.data.adminReviewNote == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == ''
        && fieldReportAssignmentAfter().volunteerId
