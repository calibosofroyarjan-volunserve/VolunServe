        && request.resource.data.assignedVolunteersCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.publishedAt is timestamp;
      allow delete: if isAdmin();
    }
    match /barangayNeedAssessments/{assessmentId} {
      function validBarangayNeedPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'assessmentId',
          'barangay',
          'sourceType',
          'sourceCaseId',
          'sourceFieldReportId',
          'affectedHouseholds',
          'affectedPeople',
          'peopleNeedingFood',
          'peopleNeedingWater',
          'peopleNeedingClothing',
          'peopleNeedingMedical',
          'householdsNeedingShelter',
          'householdsNeedingHygiene',
          'otherNeedDescription',
          'status',
          'adminNote',
          'createdBy',
          'createdAt',
          'updatedBy',
          'updatedAt',
          'closedAt'
        ])
        && rd.assessmentId == assessmentId
        && rd.barangay is string
        && rd.barangay.size() >= 2
        && rd.barangay.size() <= 120
        && rd.sourceType in [
          'incident_review',
          'volunteer_field_report',
          'lgu_direct_assessment'
        ]
        && rd.sourceCaseId is string
        && rd.sourceCaseId.size() <= 160
        && rd.sourceFieldReportId is string
        && rd.sourceFieldReportId.size() <= 160
        && rd.affectedHouseholds is int
        && rd.affectedHouseholds >= 1
        && rd.affectedHouseholds <= 1000000
        && rd.affectedPeople is int
        && rd.affectedPeople >= 1
        && rd.affectedPeople <= 10000000
        && rd.peopleNeedingFood is int
        && rd.peopleNeedingFood >= 0
        && rd.peopleNeedingFood
          <= rd.affectedPeople
        && rd.peopleNeedingWater is int
        && rd.peopleNeedingWater >= 0
        && rd.peopleNeedingWater
          <= rd.affectedPeople
        && rd.peopleNeedingClothing is int
        && rd.peopleNeedingClothing >= 0
        && rd.peopleNeedingClothing
          <= rd.affectedPeople
        && rd.peopleNeedingMedical is int
        && rd.peopleNeedingMedical >= 0
        && rd.peopleNeedingMedical
          <= rd.affectedPeople
        && rd.householdsNeedingShelter is int
        && rd.householdsNeedingShelter >= 0
        && rd.householdsNeedingShelter
          <= rd.affectedHouseholds
        && rd.householdsNeedingHygiene is int
        && rd.householdsNeedingHygiene >= 0
        && rd.householdsNeedingHygiene
          <= rd.affectedHouseholds
        && rd.otherNeedDescription is string
        && rd.otherNeedDescription.size() <= 1000
        && rd.status in [
          'verified',
          'partially_allocated',
          'fulfilled',
          'closed'
        ]
        && rd.adminNote is string
        && rd.adminNote.size() <= 1500
        && rd.createdBy is string
        && rd.createdBy.size() > 0
        && rd.createdAt is timestamp
        && rd.updatedBy is string
        && rd.updatedBy.size() > 0
        && rd.updatedAt is timestamp
        && (
          rd.closedAt == null
          || rd.closedAt is timestamp
        );
      }
      allow read: if isAdminOrSuperAdmin();
      allow create: if isAdmin()
        && validBarangayNeedPayload()
        && request.resource.data.status == 'verified'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.closedAt == null;
      allow update: if isAdmin()
        && validBarangayNeedPayload()
        && request.resource.data.assessmentId
          == resource.data.assessmentId
        && request.resource.data.createdBy
          == resource.data.createdBy
        && request.resource.data.createdAt
          == resource.data.createdAt
        && request.resource.data.updatedBy
          == request.auth.uid
        && (
          (
            request.resource.data.status == 'closed'
            && request.resource.data.closedAt is timestamp
          )
          || (
            request.resource.data.status != 'closed'
            && request.resource.data.closedAt == null
          )
        );
      allow delete: if false;
    }
    match /lguReliefInventory/{itemId} {
      function donationInventorySourceAfter() {
        return getAfter(
          /databases/$(database)/documents/donations/$(request.resource.data.sourceReferenceId)
        ).data;
      }
      function validReliefInventoryPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'itemId',
          'category',
          'itemName',
          'unit',
          'quantityReceived',
          'quantityAvailable',
          'quantityAllocated',
          'quantityDistributed',
          'sourceType',
          'sourceReferenceId',
          'status',
          'notes',
          'createdBy',
          'createdAt',
          'updatedBy',
          'updatedAt'
        ])
        && rd.itemId == itemId
        && rd.category in [
          'food',
          'water',
          'hygiene',
          'clothing',
          'shelter',
          'medical',
          'other'
        ]
        && rd.itemName is string
        && rd.itemName.size() >= 2
        && rd.itemName.size() <= 160
        && rd.unit is string
        && rd.unit.size() >= 1
        && rd.unit.size() <= 60
        && rd.quantityReceived is number
        && rd.quantityReceived >= 0
        && rd.quantityAvailable is number
        && rd.quantityAvailable >= 0
        && rd.quantityAllocated is number
        && rd.quantityAllocated >= 0
        && rd.quantityDistributed is number
        && rd.quantityDistributed >= 0
        && (
          rd.quantityAvailable
          + rd.quantityAllocated
          + rd.quantityDistributed
        ) <= rd.quantityReceived
        && rd.sourceType in [
          'lgu_stock',
          'donation',
          'government_transfer',
          'other'
        ]
        && rd.sourceReferenceId is string
        && rd.sourceReferenceId.size() <= 200
        && rd.status in [
          'active',
          'held',
          'depleted'
        ]
        && rd.notes is string
        && rd.notes.size() <= 1000
        && rd.createdBy is string
        && rd.createdBy.size() > 0
        && rd.createdAt is timestamp
        && rd.updatedBy is string
        && rd.updatedBy.size() > 0
        && rd.updatedAt is timestamp;
      }
      allow read: if isAdminOrSuperAdmin();
      allow create: if isAdmin()
        && validReliefInventoryPayload()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.quantityAvailable
          == request.resource.data.quantityReceived
        && request.resource.data.quantityAllocated == 0
        && request.resource.data.quantityDistributed == 0
        && (
          request.resource.data.sourceType != 'donation'
          || (
            request.resource.data.sourceReferenceId.size() > 0
            && request.resource.data.itemId
              == 'donation_' + request.resource.data.sourceReferenceId
            && donationInventorySourceAfter().status == 'received'
            && donationInventorySourceAfter().donationType == 'in_kind'
            && donationInventorySourceAfter().actualQuantityReceived
              == request.resource.data.quantityReceived
            && donationInventorySourceAfter().verifiedBy
              == request.auth.uid
          )
        );
      allow update: if isAdmin()
        && validReliefInventoryPayload()
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.sourceReferenceId
          == resource.data.sourceReferenceId
        && (
          resource.data.sourceType != 'donation'
          || request.resource.data.quantityReceived
            == resource.data.quantityReceived
        );
      allow delete: if false;
    }
    match /barangayReliefAllocations/{allocationId} {
      function allocationInventoryBefore() {
        return get(
          /databases/$(database)/documents/lguReliefInventory/$(request.resource.data.inventoryItemId)
        ).data;
      }
      function allocationInventoryAfter() {
        return getAfter(
          /databases/$(database)/documents/lguReliefInventory/$(request.resource.data.inventoryItemId)
        ).data;
      }
      function validAllocationPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'allocationId',
          'barangay',
          'needAssessmentIds',
          'inventoryItemId',
          'category',
          'itemName',
          'unit',
          'quantityAllocated',
          'quantityDistributed',
          'status',
          'volunteerSupportRequested',
          'assignedVolunteerIds',
          'distributionNote',
          'createdBy',
          'createdAt',
          'updatedBy',
          'updatedAt',
          'completedAt',
          'cancelledAt'
        ])
        && rd.allocationId == allocationId
        && rd.barangay is string
        && rd.barangay.size() >= 2
        && rd.barangay.size() <= 120
        && rd.needAssessmentIds is list
        && rd.needAssessmentIds.size() >= 1
        && rd.needAssessmentIds.size() <= 50
        && rd.inventoryItemId is string
        && rd.inventoryItemId.size() > 0
        && rd.inventoryItemId.size() <= 160
        && rd.category in [
          'food',
          'water',
          'hygiene',
          'clothing',
          'shelter',
          'medical',
          'other'
        ]
        && rd.itemName is string
        && rd.itemName.size() >= 2
        && rd.itemName.size() <= 160
        && rd.unit is string
        && rd.unit.size() >= 1
        && rd.unit.size() <= 40
        && rd.quantityAllocated is number
        && rd.quantityAllocated > 0
        && rd.quantityDistributed is number
        && rd.quantityDistributed >= 0
        && rd.quantityDistributed
          <= rd.quantityAllocated
        && rd.status in [
          'allocated',
          'in_distribution',
          'completed',
          'cancelled'
        ]
        && rd.volunteerSupportRequested is bool
        && rd.assignedVolunteerIds is list
        && rd.assignedVolunteerIds.size() <= 50
        && rd.distributionNote is string
        && rd.distributionNote.size() <= 1500
        && rd.createdBy is string
        && rd.createdBy.size() > 0
        && rd.createdAt is timestamp
        && rd.updatedBy is string
        && rd.updatedBy.size() > 0
        && rd.updatedAt is timestamp
        && (
          rd.completedAt == null
          || rd.completedAt is timestamp
        )
        && (
          rd.cancelledAt == null
          || rd.cancelledAt is timestamp
        );
      }
      function validInventoryReservation() {
        let inventoryBefore = allocationInventoryBefore();
        let inventoryAfter = allocationInventoryAfter();
        return inventoryBefore.itemId
            == request.resource.data.inventoryItemId
          && inventoryBefore.category
            == request.resource.data.category
          && inventoryBefore.itemName
            == request.resource.data.itemName
          && inventoryBefore.unit
            == request.resource.data.unit
          && inventoryBefore.status == 'active'
          && inventoryBefore.quantityAvailable
            >= request.resource.data.quantityAllocated
          && inventoryAfter.quantityReceived
            == inventoryBefore.quantityReceived
          && inventoryAfter.quantityAvailable
            == inventoryBefore.quantityAvailable
              - request.resource.data.quantityAllocated
          && inventoryAfter.quantityAllocated
            == inventoryBefore.quantityAllocated
              + request.resource.data.quantityAllocated
          && inventoryAfter.quantityDistributed
            == inventoryBefore.quantityDistributed;
      }
      function validCompletedInventoryReconciliation() {
        let inventoryBefore = allocationInventoryBefore();
        let inventoryAfter = allocationInventoryAfter();
        return inventoryBefore.quantityAllocated
            >= resource.data.quantityAllocated
          && inventoryAfter.quantityReceived
            == inventoryBefore.quantityReceived
          && inventoryAfter.quantityAvailable
            == inventoryBefore.quantityAvailable
              + (
                resource.data.quantityAllocated
                - request.resource.data.quantityDistributed
              )
          && inventoryAfter.quantityAllocated
            == inventoryBefore.quantityAllocated
              - resource.data.quantityAllocated
          && inventoryAfter.quantityDistributed
            == inventoryBefore.quantityDistributed
              + request.resource.data.quantityDistributed;
      }
      function validCancelledInventoryReconciliation() {
        let inventoryBefore = allocationInventoryBefore();
        let inventoryAfter = allocationInventoryAfter();
        return inventoryBefore.quantityAllocated
            >= resource.data.quantityAllocated
          && inventoryAfter.quantityReceived
            == inventoryBefore.quantityReceived
          && inventoryAfter.quantityAvailable
            == inventoryBefore.quantityAvailable
              + resource.data.quantityAllocated
          && inventoryAfter.quantityAllocated
            == inventoryBefore.quantityAllocated
              - resource.data.quantityAllocated
          && inventoryAfter.quantityDistributed
            == inventoryBefore.quantityDistributed;
      }
      allow read: if isAdminOrSuperAdmin()
        || (
          hasVolunteerAccess()
          && resource.data.assignedVolunteerIds is list
          && request.auth.uid in resource.data.assignedVolunteerIds
        );
      allow create: if isAdmin()
        && validAllocationPayload()
        && request.resource.data.status == 'allocated'
        && request.resource.data.quantityDistributed == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.completedAt == null
        && request.resource.data.cancelledAt == null
        && validInventoryReservation();
      allow update: if isAdmin()
        && validAllocationPayload()
        && request.resource.data.updatedBy
          == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'quantityDistributed',
            'volunteerSupportRequested',
            'assignedVolunteerIds',
            'distributionNote',
            'updatedBy',
            'updatedAt',
            'completedAt',
            'cancelledAt'
          ])
        && (
          (
            resource.data.status == 'allocated'
            && request.resource.data.status == 'allocated'
            && request.resource.data.quantityDistributed
              == resource.data.quantityDistributed
            && request.resource.data.completedAt == null
            && request.resource.data.cancelledAt == null
          )
          ||
          (
            resource.data.status == 'allocated'
            && request.resource.data.status == 'in_distribution'
            && request.resource.data.quantityDistributed
              == resource.data.quantityDistributed
            && request.resource.data.completedAt == null
            && request.resource.data.cancelledAt == null
          )
          ||
          (
            resource.data.status == 'in_distribution'
            && request.resource.data.status == 'in_distribution'
            && request.resource.data.quantityDistributed
              == resource.data.quantityDistributed
            && request.resource.data.completedAt == null
            && request.resource.data.cancelledAt == null
          )
          ||
          (
            resource.data.status in [
              'allocated',
              'in_distribution'
            ]
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt is timestamp
            && request.resource.data.cancelledAt == null
            && validCompletedInventoryReconciliation()
          )
          ||
          (
            resource.data.status in [
              'allocated',
              'in_distribution'
            ]
            && request.resource.data.status == 'cancelled'
            && resource.data.quantityDistributed == 0
            && request.resource.data.quantityDistributed == 0
            && request.resource.data.completedAt == null
            && request.resource.data.cancelledAt is timestamp
            && validCancelledInventoryReconciliation()
          )
        );
      allow delete: if false;
    }
    match /volunteerEvents/{eventId} {
      allow read: if approved();
      allow create, update, delete: if isAdmin();
      match /participants/{uid} {
        allow read: if approved();
        allow create: if isAdmin()
          || (
            isVolunteer()
            && request.auth.uid == uid
            && request.resource.data.uid == uid
          );
        allow update: if isAdmin();
        allow update: if isVolunteer()
          && request.auth.uid == uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'checkedInAt',
              'checkedOutAt',
              'attendanceStatus',
              'updatedAt'
            ]);
        allow delete: if isAdmin()
          || (
            isVolunteer()
            && request.auth.uid == uid
          );
      }
    }
    match /caseInvitations/{invitationId} {
      allow create, delete: if isAdmin();
      allow read: if isAdminOrSuperAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'respondedAt'
            ])
        );
    }
    // Backend Admin SDK only: private review/approval/acknowledgment audit.
    // Clients must use role-validated API, never write or inspect direct records.
    match /fundReleaseDemos/{releaseId} {
      allow read, write: if false;
    }
    match /donationCampaigns/{campaignId} {
      function campaignSourceNeed() {
        return get(
          /databases/$(database)/documents/barangayNeedAssessments/$(request.resource.data.sourceNeedAssessmentIds[0])
        ).data;
      }
      function validCampaignPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'campaignId',
          'title',
          'description',
          'status',
          'sourceType',
          'campaignGroup',
          'campaignCategory',
          'beneficiaryType',
          'generalArea',
          'sourceNeedAssessmentIds',
          'barangays',
          'acceptedDonationTypes',
          'acceptedCategories',
          'officialChannelLabel',
          'officialChannelInstructions',
          'monetaryGoal',
          'verifiedAmountReceived',
          'inKindInstructions',
          'handoffMode',
          'handoffLocationType',
          'handoffLocationName',
          'handoffAddress',
          'handoffNotes',
          'publicStory',
          'publicLocationLabel',
          'publicIncidentType',
          'publicSeverity',
          'publicPhotoUrls',
          'affectedHouseholds',
          'affectedPeople',
          'publicNeeds',
          'createdBy',
          'createdAt',
          'updatedBy',
          'updatedAt',
          'closedBy',
          'closedAt'
        ])
        && rd.campaignId == campaignId
        && rd.title is string
        && rd.title.size() >= 5
        && rd.title.size() <= 160
        && rd.description is string
        && rd.description.size() >= 15
        && rd.description.size() <= 1200
        && rd.sourceType == 'disaster_relief_need'
        && rd.campaignGroup == 'disaster_affected'
        && rd.campaignCategory is string
        && rd.campaignCategory.size() >= 2
        && rd.campaignCategory.size() <= 80
        && rd.beneficiaryType in [
          'Household Relief',
          'Community Relief'
        ]
        && rd.generalArea is string
        && rd.generalArea.size() >= 3
        && rd.generalArea.size() <= 240
        && rd.sourceNeedAssessmentIds is list
        && rd.sourceNeedAssessmentIds.size() == 1
        && rd.barangays is list
        && rd.barangays.size() == 1
        && (
          rd.acceptedDonationTypes == [
            'monetary'
          ]
          || rd.acceptedDonationTypes == [
            'in_kind'
          ]
          || rd.acceptedDonationTypes == [
            'monetary',
            'in_kind'
          ]
          || rd.acceptedDonationTypes == [
            'in_kind',
            'monetary'
          ]
        )
        && rd.acceptedCategories is list
        && rd.acceptedCategories.size() <= 7
        && rd.officialChannelLabel is string
        && rd.officialChannelLabel.size() <= 160
        && rd.officialChannelInstructions is string
        && rd.officialChannelInstructions.size() <= 1000
        && rd.inKindInstructions is string
        && rd.inKindInstructions.size() <= 1000
        && rd.handoffMode in [
          'receiving_point',
          'coordinated_handover',
          'both'
        ]
        && rd.handoffLocationType is string
        && rd.handoffLocationType.size() <= 80
        && rd.handoffLocationName is string
        && rd.handoffLocationName.size() <= 180
        && rd.handoffAddress is string
        && rd.handoffAddress.size() <= 320
        && rd.handoffNotes is string
        && rd.handoffNotes.size() <= 600
        && rd.publicStory is string
        && rd.publicStory.size() >= 30
        && rd.publicStory.size() <= 1200
        && rd.publicLocationLabel is string
        && rd.publicLocationLabel.size() >= 3
        && rd.publicLocationLabel.size() <= 240
        && rd.generalArea
          == rd.publicLocationLabel
        && rd.publicIncidentType is string
        && rd.publicIncidentType.size() >= 2
        && rd.publicIncidentType.size() <= 120
        && rd.publicSeverity is string
        && rd.publicSeverity.size() >= 2
        && rd.publicSeverity.size() <= 80
        && rd.publicPhotoUrls is list
        && rd.publicPhotoUrls.size() <= 5
        && rd.affectedHouseholds is int
        && rd.affectedHouseholds >= 1
        && rd.affectedPeople is int
        && rd.affectedPeople >= 1
        && rd.publicNeeds is list
        && rd.publicNeeds.size() <= 7
        && rd.createdBy is string
        && rd.createdBy.size() > 0
        && rd.createdAt is timestamp
        && rd.updatedBy is string
        && rd.updatedBy.size() > 0
        && rd.updatedAt is timestamp
        && (
          !('monetary' in rd.acceptedDonationTypes)
          || (
            rd.officialChannelLabel.size() >= 3
            && rd.officialChannelInstructions.size() >= 10
            && rd.monetaryGoal > 0
          )
        )
        && (
          'monetary' in rd.acceptedDonationTypes
          || (
            rd.officialChannelLabel == ''
            && rd.officialChannelInstructions == ''
            && rd.monetaryGoal == 0
          )
        )
        && rd.verifiedAmountReceived == 0
        && (
          !('in_kind' in rd.acceptedDonationTypes)
          || (
            rd.acceptedCategories.size() >= 1
            && rd.inKindInstructions.size() >= 10
            && rd.handoffLocationType in [
              'barangay_relief_desk',
              'evacuation_center',
              'lgu_relief_center',
              'city_hall',
              'hospital_social_service',
              'veterinary_clinic',
              'social_welfare_office',
              'animal_shelter',
              'approved_public_meeting',
              'other'
            ]
            && rd.handoffLocationName.size() >= 3
            && rd.handoffAddress.size() >= 8
          )
        )
        && (
          'in_kind' in rd.acceptedDonationTypes
          || (
            rd.acceptedCategories.size() == 0
            && rd.inKindInstructions == ''
            && rd.handoffMode == 'receiving_point'
            && rd.handoffLocationType == ''
            && rd.handoffLocationName == ''
            && rd.handoffAddress == ''
            && rd.handoffNotes == ''
          )
        );
      }
      function validCampaignClose() {
        return resource.data.status == 'published'
          && request.resource.data.status == 'closed'
          && request.resource.data.campaignId == resource.data.campaignId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'closedBy',
              'closedAt',
              'updatedBy',
              'updatedAt'
            ])
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.closedAt is timestamp
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }
      function validVerifiedFundingProgressUpdate() {
        return resource.data.status == 'published'
          && request.resource.data.status == 'published'
          && 'monetary' in resource.data.acceptedDonationTypes
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'verifiedAmountReceived',
              'updatedBy',
              'updatedAt'
            ])
          && request.resource.data.verifiedAmountReceived is number
          && (
            (
              !('verifiedAmountReceived' in resource.data)
              && request.resource.data.verifiedAmountReceived > 0
            )
            || (
              'verifiedAmountReceived' in resource.data
              && request.resource.data.verifiedAmountReceived
                > resource.data.verifiedAmountReceived
            )
          )
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }
      function validSourceNeedForCampaign() {
        let need = campaignSourceNeed();
        return need.status in [
          'verified',
          'partially_allocated'
        ]
        && request.resource.data.affectedHouseholds
          == need.affectedHouseholds
        && request.resource.data.affectedPeople
          == need.affectedPeople
        && request.resource.data.barangays[0]
          == need.barangay;
      }

      // Financial operations and campaign oversight are LGU Admin duties.
      allow read: if isAdmin()
        || hasResidentAccess();
      allow create: if isAdmin()
        && validCampaignPayload()
        && request.resource.data.status == 'published'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && !('closedBy' in request.resource.data)
        && !('closedAt' in request.resource.data)
        && validSourceNeedForCampaign();
      allow update: if isAdmin()
        && (
          validCampaignClose()
          || validVerifiedFundingProgressUpdate()
        );
      allow delete: if false;
    }
    match /donations/{donationId} {
      function submissionCampaign() {
        return get(
          /databases/$(database)/documents/donationCampaigns/$(request.resource.data.campaignId)
        ).data;
      }
      function validDonationSubmission() {
        let rd = request.resource.data;
        let campaign = submissionCampaign();
        return rd.keys().hasOnly([
          'donationId',
          'source',
          'campaignId',
          'campaignTitle',
          'campaignBarangays',
          'donorUid',
          'donorName',
          'donorDisplayName',
          'donationType',
          'category',
          'itemName',
          'unit',
          'quantityPledged',
          'amount',
          'transactionReference',
          'donorNote',
          'proofUrls',
          'status',
          'actualQuantityReceived',
          'actualAmountReceived',
          'officialReceiptReference',
          'rejectionReason',
          'createdAt',
          'updatedAt'
        ])
        && rd.donationId == donationId
        && rd.source == 'campaign_submission'
        && rd.campaignId is string
        && rd.campaignId.size() > 0
        && rd.campaignId.size() <= 160
        && campaign.status == 'published'
        && rd.campaignTitle
          == campaign.title
        && rd.campaignBarangays
          == campaign.barangays
        && rd.donorUid == request.auth.uid
        && rd.donorName is string
        && rd.donorName.size() >= 1
        && rd.donorName.size() <= 160
        && rd.donorDisplayName is string
        && rd.donorDisplayName.size() >= 1
        && rd.donorDisplayName.size() <= 160
        && rd.donationType
          in campaign.acceptedDonationTypes
        && rd.category is string
        && rd.category.size() <= 80
        && rd.itemName is string
        && rd.itemName.size() <= 160
        && rd.unit is string
        && rd.unit.size() <= 60
        && rd.transactionReference is string
        && rd.transactionReference.size() <= 160
        && rd.donorNote is string
        && rd.donorNote.size() <= 600
        && rd.proofUrls is list
        && rd.proofUrls.size() <= 5
        && rd.status == 'submitted'
        && rd.actualQuantityReceived == 0
        && rd.actualAmountReceived == 0
        && rd.officialReceiptReference == ''
        && rd.rejectionReason == ''
        && rd.createdAt is timestamp
        && rd.updatedAt is timestamp
        && (
          (
            rd.donationType == 'monetary'
            && rd.category == ''
            && rd.itemName == ''
            && rd.unit == ''
            && rd.quantityPledged == 0
            && rd.amount > 0
            && rd.transactionReference.size() >= 4
          )
          || (
            rd.donationType == 'in_kind'
            && rd.category.size() >= 2
            && rd.category
              in campaign.acceptedCategories
            && rd.itemName.size() >= 2
            && rd.unit.size() >= 1
            && rd.quantityPledged is int
            && rd.quantityPledged > 0
            && rd.amount == 0
            && rd.transactionReference == ''
          )
        );
      }
      function validDonationReceiptVerification() {
        let rd = request.resource.data;
        return resource.data.status == 'submitted'
          && rd.status == 'received'
          && rd
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'actualQuantityReceived',
              'actualAmountReceived',
              'officialReceiptReference',
              'verifiedBy',
              'verifiedAt',
              'receivedBy',
              'receivedAt',
              'updatedAt',
              'rejectionReason'
            ])
          && rd.officialReceiptReference is string
          && rd.officialReceiptReference.size() >= 3
          && rd.officialReceiptReference.size() <= 160
          && rd.verifiedBy == request.auth.uid
          && rd.receivedBy == request.auth.uid
          && rd.verifiedAt is timestamp
          && rd.receivedAt is timestamp
          && rd.updatedAt is timestamp
          && rd.rejectionReason == ''
          && (
            (
              resource.data.donationType == 'monetary'
              && rd.actualAmountReceived is number
              && rd.actualAmountReceived > 0
              && rd.actualQuantityReceived == 0
            )
            || (
              resource.data.donationType == 'in_kind'
              && rd.actualQuantityReceived is int
              && rd.actualQuantityReceived > 0
              && rd.actualAmountReceived == 0
            )
          );
      }
      function validDonationRejection() {
        return resource.data.status == 'submitted'
          && request.resource.data.status == 'rejected'
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'rejectionReason',
              'rejectedBy',
              'rejectedAt',
              'updatedAt'
            ])
          && request.resource.data.rejectionReason is string
          && request.resource.data.rejectionReason.size() >= 5
          && request.resource.data.rejectionReason.size() <= 600
          && request.resource.data.rejectedBy == request.auth.uid
          && request.resource.data.rejectedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }
      allow create: if hasResidentAccess()
        && validDonationSubmission();
      allow read: if isAdmin()
        || (
          hasResidentAccess()
          && resource.data.donorUid == request.auth.uid
        );
      allow update: if isAdmin()
        && (
          validDonationReceiptVerification()
          || validDonationRejection()
        );
      allow delete: if false;
      match /logs/{logId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }
    match /publicDonationVerifications/{donationId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /publicDonationDistributions/{donationId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /certificates/{certificateId} {
      allow read: if isAdminOrSuperAdmin()
        || (
          approved()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.volunteerId == request.auth.uid
          )
        );
      allow create: if isAdmin()
        && request.resource.data.certificateId == certificateId
        && request.resource.data.certificateType
          == 'verified_volunteer_service'
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.volunteerId
          == request.resource.data.userId
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 120
        && request.resource.data.verificationStatus == 'issued'
        && request.resource.data.verifiedHelps is int
        && request.resource.data.verifiedHelps >= 1
        && request.resource.data.verifiedServiceMinutes is int
        && request.resource.data.verifiedServiceMinutes >= 0
        && request.resource.data.peopleHelped is int
        && request.resource.data.peopleHelped >= 0
        && request.resource.data.contributionIds is list
        && request.resource.data.contributionIds.size() >= 1
        && request.resource.data.snapshotHash is string
        && request.resource.data.snapshotHash.size() > 0
        && request.resource.data.issuedAt is timestamp
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'revocationReason',
            'revokedAt',
            'revokedBy',
            'revokedByName',
            'updatedAt'
          ])
        && resource.data.verificationStatus == 'issued'
        && request.resource.data.verificationStatus == 'revoked'
        && request.resource.data.revocationReason is string
        && request.resource.data.revocationReason.size() >= 10
        && request.resource.data.revocationReason.size() <= 500
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /publicCertificateVerifications/{certificateId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'certificateId',
          'certificateType',
          'certificateTitle',
          'volunteerName',
          'verifiedHelps',
          'fullVerifiedHelps',
          'partialVerifiedHelps',
          'verifiedEmergencyResponses',
          'verifiedServiceMinutes',
          'peopleHelped',
          'contributionBreakdown',
          'contributionCount',
          'snapshotHash',
          'verificationStatus',
          'issuedByName',
          'issuedByRole',
          'issuerOrganization',
          'issuedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.certificateId == certificateId
        && request.resource.data.certificateType
          == 'verified_volunteer_service'
        && (
          !('certificateTitle' in request.resource.data)
          || request.resource.data.certificateTitle is string
        )
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 120
        && request.resource.data.verificationStatus == 'issued'
        && request.resource.data.verifiedHelps is int
        && request.resource.data.verifiedHelps >= 1
        && (
          !('fullVerifiedHelps' in request.resource.data)
          || (
            request.resource.data.fullVerifiedHelps is int
            && request.resource.data.fullVerifiedHelps >= 0
          )
        )
        && (
          !('partialVerifiedHelps' in request.resource.data)
          || (
            request.resource.data.partialVerifiedHelps is int
            && request.resource.data.partialVerifiedHelps >= 0
          )
        )
        && (
          !('verifiedEmergencyResponses' in request.resource.data)
          || (
            request.resource.data.verifiedEmergencyResponses is int
            && request.resource.data.verifiedEmergencyResponses >= 0
          )
        )
        && request.resource.data.verifiedServiceMinutes is int
        && request.resource.data.verifiedServiceMinutes >= 0
        && request.resource.data.peopleHelped is int
        && request.resource.data.peopleHelped >= 0
        && request.resource.data.contributionBreakdown is list
        && (
          !('contributionCount' in request.resource.data)
          || (
            request.resource.data.contributionCount is int
            && request.resource.data.contributionCount >= 1
          )
        )
        && request.resource.data.snapshotHash is string
        && request.resource.data.snapshotHash.size() > 0
        && (
          !('issuedByName' in request.resource.data)
          || request.resource.data.issuedByName is string
        )
        && (
          !('issuedByRole' in request.resource.data)
          || request.resource.data.issuedByRole is string
        )
        && (
          !('issuerOrganization' in request.resource.data)
          || request.resource.data.issuerOrganization is string
        )
        && request.resource.data.issuedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'revocationReason',
            'revokedAt',
            'revokedByName',
            'updatedAt'
          ])
        && resource.data.verificationStatus == 'issued'
        && request.resource.data.verificationStatus == 'revoked'
        && request.resource.data.revocationReason is string
        && request.resource.data.revocationReason.size() >= 10
        && request.resource.data.revocationReason.size() <= 500
        && request.resource.data.revokedByName is string
        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /volunteerStats/{uid} {
      allow read: if approved();
      allow write: if isAdmin();
    }
    match /verifiedContributions/{assignmentId} {
      function contributionAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }
      function contributionCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }
      function contributionConfirmation() {
        return getAfter(
          /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
        ).data;
      }
      function validContributionSnapshot() {
        let assignment = contributionAssignment();
        let confirmation = contributionConfirmation();
        return request.resource.data.assignmentId == assignmentId
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.outcome in [
          'fully_helped',
          'partially_helped'
        ]
        && request.resource.data.status == 'verified'
        && request.resource.data.verificationSource
          == 'resident_confirmation'
        && request.resource.data.caseId
          == assignment.caseId
        && request.resource.data.volunteerId
          == assignment.volunteerId
        && request.resource.data.volunteerId
          != request.auth.uid
        && request.resource.data.volunteerName
          == assignment.volunteerName
        && assignment.status == 'completed'
        && contributionCase().reporterUid == request.auth.uid
        && request.resource.data.contributionType
          == assignment.contributionType
        && request.resource.data.contributionSummary
          == assignment.contributionSummary
        && request.resource.data.peopleHelped
          == assignment.peopleHelped
        && request.resource.data.completionNotes
          == assignment.completionNotes
        && request.resource.data.responseStartedAt
          == assignment.responseStartedAt
        && request.resource.data.arrivedAt
          == assignment.arrivedAt
        && request.resource.data.completedAt
          == assignment.completedAt
        && confirmation.assignmentId == assignmentId
        && confirmation.residentId
          == request.auth.uid
        && confirmation.volunteerId
          == request.resource.data.volunteerId
        && confirmation.outcome
          == request.resource.data.outcome
        && confirmation.reviewState
          == 'resident_confirmed'
        && confirmation.creditStatus
          == 'credited'
        && request.resource.data.residentConfirmedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.verifiedAt is timestamp;
      }
      allow read: if isAdminOrSuperAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        )
        || (
          approved()
          && resource.data.residentId == request.auth.uid
        );
      allow create: if isResident()
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',
          'volunteerId',
          'volunteerName',
          'residentId',
          'outcome',
          'contributionType',
          'contributionSummary',
          'peopleHelped',
          'completionNotes',
          'responseStartedAt',
          'arrivedAt',
          'completedAt',
          'residentConfirmedAt',
          'verificationSource',
          'status',
          'createdAt',
          'verifiedAt'
        ])
        && validContributionSnapshot();
      allow update, delete: if false;
    }
    match /responseDisputes/{assignmentId} {
      function disputeAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }
      function disputeCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }
      function disputeConfirmation() {
        return getAfter(
          /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
        ).data;
      }
      function validDisputeSnapshot() {
        let assignment = disputeAssignment();
        let confirmation = disputeConfirmation();
        return request.resource.data.assignmentId == assignmentId
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.residentNote is string
        && request.resource.data.residentNote.size() >= 10
        && request.resource.data.residentNote.size() <= 1000
        && assignment.status == 'completed'
        && assignment.caseId
          == request.resource.data.caseId
        && assignment.volunteerId
          == request.resource.data.volunteerId
        && request.resource.data.volunteerId
          != request.auth.uid
        && request.resource.data.contributionType
          == assignment.contributionType
        && request.resource.data.contributionSummary
          == assignment.contributionSummary
        && disputeCase().reporterUid == request.auth.uid
        && confirmation.assignmentId == assignmentId
        && confirmation.outcome == 'not_helped'
        && confirmation.reviewState == 'disputed'
        && confirmation.creditStatus == 'disputed'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }
      allow read: if isAdminOrSuperAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        )
        || (
          approved()
          && resource.data.residentId == request.auth.uid
        );
      allow create: if isResident()
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',
          'volunteerId',
          'residentId',
          'residentNote',
          'contributionType',
          'contributionSummary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && validDisputeSnapshot();
      allow update: if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'adminNote',
            'resolvedAt',
            'resolvedBy',
            'updatedAt'
          ])
        && request.resource.data.status in [
          'open',
          'resolved',
          'dismissed'
        ]
        && (
          !('adminNote' in request.resource.data)
          || request.resource.data.adminNote is string
        )
        && (
          !('resolvedAt' in request.resource.data)
          || request.resource.data.resolvedAt is timestamp
        )
        && (
          !('resolvedBy' in request.resource.data)
          || request.resource.data.resolvedBy == request.auth.uid
        )
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /responseAuditLogs/{logId} {
      allow read: if isAdminOrSuperAdmin();
      allow create, update, delete: if false;
    }
    match /notifications/{notificationId} {
      function responderNotificationAssignment() {
        return getAfter(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }
      function responderNotificationCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }
      allow create: if isAdmin();
      allow create: if isVolunteer()
        && request.resource.data.keys().hasOnly([
          'userId',
          'caseId',
          'assignmentId',
          'responderId',
          'responderName',
          'title',
          'message',
          'type',
          'status',
          'read',
          'createdAt'
        ])
        && request.resource.data.userId is string
        && request.resource.data.caseId is string
        && request.resource.data.assignmentId is string
        && request.resource.data.responderId == request.auth.uid
        && request.resource.data.responderName is string
        && request.resource.data.responderName.size() >= 1
        && request.resource.data.responderName.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.type == 'resident_response_update'
        && request.resource.data.status in [
          'accepted',
          'responding',
          'on_site',
          'completed'
        ]
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && responderNotificationAssignment().volunteerId
          == request.auth.uid
        && responderNotificationAssignment().caseId
          == request.resource.data.caseId
        && responderNotificationAssignment().status
          == request.resource.data.status
        && responderNotificationCase().reporterUid
          == request.resource.data.userId
        && request.resource.data.userId
          != request.auth.uid;
      allow read: if approved()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );
      // Recipients may acknowledge their own notification but cannot change
      // the recipient, origin, content, status, or delivery metadata.
      allow update: if approved()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read'])
        && request.resource.data.read == true;
      allow read, update, delete: if isAdmin();
    }
    match /tickets/{ticketId} {
      allow create: if approved()
        && request.resource.data.keys().hasOnly([
          'submitterId',
          'submitterName',
          'submitterEmail',
          'submitterRole',
          'category',
          'subject',
          'description',
          'status',
          'priority',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.submitterRole == profile().role
        && request.resource.data.category in [
          'system',
          'task',
          'donation',
          'emergency',
          'other'
        ]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500
        && request.resource.data.status == 'open'
        && request.resource.data.priority == 'normal';
      allow read: if isAdmin()
        || (
          approved()
          && resource.data.submitterId == request.auth.uid
        );
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /evacuation_centers/{centerId} {
      // Public may read facility metadata, but clients display ACTIVE only when
      // LGU has supplied independent verification and official coordinates.
      function validCenterPayload() {
        let rd = request.resource.data;
        return rd.name is string
          && rd.name.size() >= 3
          && rd.name.size() <= 160
          && rd.address is string
          && rd.address.size() >= 3
          && rd.address.size() <= 320
          && rd.barangay is string
          && rd.barangay.size() >= 2
          && rd.latitude is number && rd.latitude >= -90 && rd.latitude <= 90
          && rd.longitude is number && rd.longitude >= -180 && rd.longitude <= 180
          && rd.capacity is int && rd.capacity >= 1
          && rd.occupied is int && rd.occupied >= 0
          && rd.occupied <= rd.capacity
          && rd.updatedBy == request.auth.uid
          && rd.updatedAt is timestamp
          && rd.status in ['active', 'pending_verification', 'inactive', 'closed']
          && rd.verificationStatus in ['pending', 'verified']
          && rd.verificationSource is string
          && rd.verificationSource.size() <= 300
          && (
            rd.status != 'active'
            || (
              rd.verificationStatus == 'verified'
              && rd.verificationSource.size() >= 10
              && rd.lastVerifiedAt is timestamp
            )
          );
      }
      allow read: if true;
      allow create, update: if isAdmin() && validCenterPayload();
      allow delete: if isAdmin();
    }
    match /users_live_locations/{uid} {
      allow read: if isAdmin()
        || (
          isVolunteer()
          && request.auth.uid == uid
        );
      allow create, update, delete: if approved()
        && request.auth.uid == uid;
    }
    match /volunteers_live_locations/{uid} {
      allow read: if isAdmin()
        || isVolunteer();
      allow create, update, delete: if isVolunteer()
        && request.auth.uid == uid;
    }
    match /caseMessages/{caseId}/messages/{messageId} {
      function chatCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(caseId)
        ).data;
      }
      function existingChatAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(resource.data.assignmentId)
        ).data;
      }
      function incomingChatAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }
      function validReadableChatAssignment() {
        return resource.data.caseId == caseId
          && existingChatAssignment().caseId == caseId
          && existingChatAssignment().status in [
            'accepted',
            'responding',
            'on_site',
            'completed'
          ];
      }
      function validIncomingChatAssignment() {
        return request.resource.data.caseId == caseId
          && incomingChatAssignment().caseId == caseId
          && incomingChatAssignment().status in [
            'accepted',
            'responding',
            'on_site',
            'completed'
          ];
      }
      allow read: if isAdmin()
        || (
          isResident()
          && chatCase().reporterUid == request.auth.uid
          && validReadableChatAssignment()
        )
        || (
          isVolunteer()
          && existingChatAssignment().volunteerId == request.auth.uid
          && validReadableChatAssignment()
        );
      allow create: if approved()
        && request.resource.data.keys().hasOnly([
          'caseId',
          'assignmentId',
          'senderUid',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ])
        && request.resource.data.caseId == caseId
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.senderRole in [
          'resident',
          'volunteer',
          'admin'
        ]
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && chatCase().status in [
          'assigned',
          'in_progress'
        ]
        && validIncomingChatAssignment()
        && (
          (
            isAdmin()
            && request.resource.data.senderRole == 'admin'
          )
          || (
            isResident()
            && chatCase().reporterUid == request.auth.uid
            && request.resource.data.senderRole == 'resident'
          )
          || (
            isVolunteer()
            && incomingChatAssignment().volunteerId == request.auth.uid
            && chatCase().reporterUid != request.auth.uid
            && request.resource.data.senderRole == 'volunteer'
          )
        );
      allow update, delete: if false;
    }
    // Preserve the exact previously deployed volunteer-invitation policy.
    // This invitation is consent/availability only, not dispatch or live GPS.
    match /volunteerInvitations/{invitationId} {
      function selectedVolunteer() {
        return get(
          /databases/$(database)/documents/users/$(request.resource.data.volunteerId)
        ).data;
      }

      function selectedCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      function validInvitationTargets() {
        let caseInfo = selectedCase();
        let volunteer = selectedVolunteer();
        return caseInfo.reporterUid != request.resource.data.volunteerId
        && !(caseInfo.status in ['resolved', 'closed'])
        && caseInfo.get('verificationStatus', 'pending_verification') != 'rejected'
        && volunteer.get('status', '') == 'approved'
        && volunteer.get('volunteerAccess', false) == true
        && volunteer.get('volunteerStatus', '') == 'approved'
        && !(volunteer.get('role', '') in [
          'admin', 'superadmin', 'lgu_personnel', 'applicant'
        ]);
      }

      allow read: if isAdmin()
        || (hasVolunteerAccess() && resource.data.volunteerId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'caseId', 'caseTitle', 'volunteerId', 'volunteerName',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0
        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerId.size() > 0
        && invitationId == request.resource.data.caseId + '_' + request.resource.data.volunteerId
        && request.resource.data.caseTitle is string
        && request.resource.data.caseTitle.size() >= 1
        && request.resource.data.caseTitle.size() <= 200
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 160
        && request.resource.data.status == 'invited'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.volunteerId)
        )
        && exists(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        )
        && validInvitationTargets();
      allow update: if request.resource.data
          .diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (isAdmin()
            && resource.data.status == 'declined'
            && request.resource.data.status == 'invited')
          || (hasVolunteerAccess()
            && resource.data.volunteerId == request.auth.uid
            && resource.data.status == 'invited'
            && request.resource.data.status in ['accepted', 'declined'])
        );
      allow delete: if false;
    }

    match /responseAssignments/{assignmentId} {


      function validVolunteerResponseTransition() {
        return (
          resource.data.status == 'offered'
          && request.resource.data.status in [
            'accepted',
            'declined'
          ]
        )
        || (
          resource.data.status == 'accepted'
          && request.resource.data.status == 'responding'
        )
        || (
          resource.data.status == 'responding'
          && request.resource.data.status == 'on_site'
        )
        || (
          resource.data.status == 'on_site'
          && request.resource.data.status == 'completed'
        );
      }
      function validVolunteerResponseFields() {
        let rd = request.resource.data;
        let changed = rd
          .diff(resource.data)
          .affectedKeys();
        return (
          resource.data.status == 'offered'
          && rd.status in [
            'accepted',
            'declined'
          ]
          && changed.hasOnly([
            'status',
            'updatedAt'
          ])
        )
        || (
          resource.data.status == 'accepted'
          && rd.status == 'responding'
          && changed.hasOnly([
            'status',
            'updatedAt',
            'responseStartedAt'
          ])
          && rd.responseStartedAt is timestamp
        )
        || (
          resource.data.status == 'responding'
          && rd.status == 'on_site'
          && changed.hasOnly([
            'status',
            'updatedAt',
            'arrivedAt'
          ])
          && rd.arrivedAt is timestamp
        )
        || (
          resource.data.status == 'on_site'
          && rd.status == 'completed'
          && changed.hasOnly([
            'status',
            'updatedAt',
            'contributionType',
            'contributionSummary',
            'peopleHelped',
            'completionNotes',
            'completedAt',
            'residentConfirmationStatus'
          ])
          && rd.contributionType is string
          && rd.contributionType.size() > 0
          && rd.contributionType.size() <= 100
          && rd.contributionSummary is string
          && rd.contributionSummary.size() >= 10
          && rd.contributionSummary.size() <= 1200
          && rd.peopleHelped is int
          && rd.peopleHelped >= 0
          && rd.peopleHelped <= 999
          && rd.completionNotes is string
          && rd.completionNotes.size() <= 600
          && rd.completedAt is timestamp
          && rd.residentConfirmationStatus
            == 'pending'
        );
      }
      function assignmentCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(resource.data.caseId)
        ).data;
      }
      function incomingAssignmentCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }
      function incomingVolunteerProfile() {
        return get(
          /databases/$(database)/documents/users/$(request.resource.data.volunteerId)
        ).data;
      }
      function incomingVolunteerIsApproved() {
        let volunteer = incomingVolunteerProfile();
        return 'status' in volunteer
