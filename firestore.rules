rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }
    // Firebase Auth sign-in alone never grants Firestore permissions.
    // Staff and community routes require a verified mailbox in the token.
    function verifiedEmailSession() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true;
    }
    // Reuse profile data inside role helpers instead of repeating get() expressions.
    // Equivalent to the previously deployed approved() predicate:
    // 1) verifiedEmailSession already guarantees email_verified == true;
    // 2) the explicit role allow-list excludes 'applicant', so a missing
    //    status field is 'approved' but a present null/nonapproved status is not.
    // This reduces repeated compiled expressions across role-sensitive rules.
    // Recent temp-mail.org delivery domains reviewed 2026-11-10.
    // Deny-only for community profiles; staff policies remain unchanged.
    // This is a finite provider snapshot and cannot detect every new domain.
    function blockedTempMailOrgAlias(email) {
      return email.matches("(?i).*@(?:[a-z0-9-]+[.])*(?:(?:adujudi01|crystalfact|indonesiacentral|livetogelhk|luontaisterveys|wbcom)[.]info|(?:avtomaty-online|emailgeneratorai|huanqiu6)[.]cc|(?:baimengshu|bankwen|berkshireonstage|boffweb|crackclue|digeros|drtall|emailkeep|gmail[.]shagni|huicuiguan|javafs|jjwxb|jlmmarine|kxdyy|macsnipe|mail[.]chosenx|mail[.]gianes|mail[.]sc2hub|mmamemories|nmwxb|prejuge|prestigegroupnet|sofabazar|spicylog|stebie|tobiquegaming-license|ttbtt|wencuigu|wxfwb|yesrox|yyqzw)[.]com|ctd[.]nl8[.]eu|doisongtinhduc[.]xyz|dragontranslation[.]net|ghostmailz[.]club|ghostmailz[.]online|ghostmailz[.]store|mailer[.]pics|(?:mpmail|wandera|zymapi)[.]top)");
    }
    function approved() {
      let p = signedIn() ? profile() : {};
      let role = p.get('role', '');
      // Exactly the original five-role allowlist: staff bypass profile-email
      // matching; only Resident/Volunteer require the Firebase email match.
      return verifiedEmailSession()
        && (
          role in ['admin', 'superadmin', 'lgu_personnel']
          || (
            role in ['resident', 'volunteer']
            && request.auth.token.get('email', '') == p.get('email', '')
            && !blockedTempMailOrgAlias(request.auth.token.get('email', ''))
          )
        )
        && p.get('status', 'approved') == 'approved'
        && p.get('adminStatus', 'active') != 'suspended';
    }
    // Reuse one verified-active staff role gate for all three staff helpers.
    // Same semantics as the previous independent isAdmin/isSuperAdmin helpers:
    // only a verified Firebase email, approved/non-suspended user profile,
    // and the exact allowed role can pass. Other roles never get staff access.
    function hasApprovedStaffRole(roles) {
      let p = signedIn() ? profile() : {};
      // roles is always a subset of ['admin','superadmin'] at call sites.
      // Therefore approved() already enforces verified mailbox and active
      // approved/non-suspended staff state. Keep exact role restriction.
      return approved()
        && p.get('role', '') in roles;
    }
    function isAdmin() {
      return hasApprovedStaffRole(['admin']);
    }
    function isSuperAdmin() {
      return hasApprovedStaffRole(['superadmin']);
    }
    function isAdminOrSuperAdmin() {
      return hasApprovedStaffRole(['admin', 'superadmin']);
    }
    function hasResidentAccess() {
      let p = signedIn() ? profile() : {};
      return approved()
        && p.role in ['resident', 'volunteer']
        && p.get('residentAccess', false) == true;
    }
    function hasVolunteerAccess() {
      let p = signedIn() ? profile() : {};
      return approved()
        && p.role in ['resident', 'volunteer']
        && p.get('volunteerAccess', false) == true
        && p.get('volunteerStatus', '') == 'approved';
    }
    function isVolunteer() {
      let p = signedIn() ? profile() : {};
      return hasVolunteerAccess() && p.get('activeMode', '') == 'volunteer';
    }
    function isResident() {
      let p = signedIn() ? profile() : {};
      return hasResidentAccess() && p.get('activeMode', 'resident') == 'resident';
    }
    // Exact shared validation predicates hoisted from identical match-local helpers.
      function hasVerifiedIdentity(data) {
        return (
          (
            'identityVerified' in data
            && data.identityVerified == true
          )
          || (
            'identityStatus' in data
            && data.identityStatus == 'verified'
          )
        );
      }
      function isVerifiedResident() {
        return isResident()
          && hasVerifiedIdentity(profile());
      }
      function isLguPersonnel() {
        let p = signedIn() ? profile() : {};
        return approved()
          && p.role == 'lgu_personnel'
          && p.lguVerified == true
          && p.employmentStatus == 'active';
      }
    match /users/{uid} {


      function identitySubmissionAfter() {
        return getAfter(
          /databases/$(database)/documents/identityVerifications/$(uid)
        ).data;
      }
      function volunteerApplicationAfter() {
        return getAfter(
          /databases/$(database)/documents/volunteerApplications/$(uid)
        ).data;
      }
      // Firestore creation must enforce the same required inputs as the wizard.
      // These lists are synchronized against the local SJDM/occupation constants.
      function validInitialResidentInputs() {
        let d = request.resource.data;
        return d.firstName is string && d.firstName.size() >= 2 && d.firstName.size() <= 80
          && d.lastName is string && d.lastName.size() >= 2 && d.lastName.size() <= 80
          && d.get('middleName', '') is string && d.get('middleName', '').size() <= 80
          && (d.phoneNumber == '' || d.phoneNumber.matches('^([+]639[0-9]{9}|09[0-9]{9})$'))
          && d.region is string && d.region.size() >= 5 && d.region.size() <= 100
          && d.barangay.matches('^(Assumption|Bagong Buhay I|Bagong Buhay II|Bagong Buhay III|Citrus|Ciudad Real|Dulong Bayan|Fatima I|Fatima II|Fatima III|Fatima IV|Fatima V|Francisco Homes-Guijo|Francisco Homes-Mulawin|Francisco Homes-Narra|Francisco Homes-Yakal|Gaya-gaya|Graceville|Gumaoc Central|Gumaoc East|Gumaoc West|Kaybanban|Kaypian|Lawang Pari|Maharlika|Minuyan I|Minuyan II|Minuyan III|Minuyan IV|Minuyan Proper|Minuyan V|Muzon East|Muzon Proper|Muzon South|Muzon West|Paradise III|Poblacion|Poblacion I|San Isidro|San Manuel|San Martin de Porres|San Martin I|San Martin II|San Martin III|San Martin IV|San Pedro|San Rafael I|San Rafael II|San Rafael III|San Rafael IV|San Rafael V|San Roque|Santa Cruz I|Santa Cruz II|Santa Cruz III|Santa Cruz IV|Santa Cruz V|Santo Cristo|Santo Niño I|Santo Niño II|Sapang Palay|Tungkong Mangga)$')
          && d.occupationCategory.matches('^(Medical Professional|Emergency Responder|Government Employee|Student|Private Sector Employee|NGO Worker|Skilled Worker|Unemployed|Retired|Other [(]Specify[)])$')
          && d.get('occupationSpecialization', '') is string
          && d.get('occupationOther', '') is string
          && d.get('occupationOther', '').size() <= 80
          && (d.occupationCategory == 'Other (Specify)' || d.get('occupationOther', '') == '')
          && (
          (d.occupationCategory == 'Medical Professional' && d.get('occupationSpecialization', '') in ['Doctor', 'Nurse', 'Midwife', 'Medical Technologist', 'Pharmacist', 'Other Medical Staff']) ||
          (d.occupationCategory == 'Emergency Responder' && d.get('occupationSpecialization', '') in ['Firefighter', 'EMT', 'Rescue Volunteer', 'DRRM Officer', 'Other Responder']) ||
          (d.occupationCategory == 'Government Employee' && d.get('occupationSpecialization', '') in ['Health Office', 'Social Welfare', 'Public Safety', 'Administrative Staff', 'Other Office']) ||
          (d.occupationCategory == 'Student' && d.get('occupationSpecialization', '') in ['Senior High School', 'College', 'Fresh Graduate', 'Technical-Vocational']) ||
          (d.occupationCategory == 'Private Sector Employee' && d.get('occupationSpecialization', '') in ['Operations', 'Customer Service', 'Engineering', 'Management', 'Other Department']) ||
          (d.occupationCategory == 'NGO Worker' && d.get('occupationSpecialization', '') in ['Program Officer', 'Field Coordinator', 'Volunteer Manager', 'Other Role']) ||
          (d.occupationCategory == 'Skilled Worker' && d.get('occupationSpecialization', '') in ['Electrician', 'Plumber', 'Driver', 'Welder', 'Carpenter', 'Other Skill']) ||
          (d.occupationCategory in ['Unemployed', 'Retired', 'Other (Specify)']
            && d.get('occupationSpecialization', '') == '')
          )
          && (d.occupationCategory != 'Other (Specify)' || d.get('occupationOther', '').size() >= 2);
      }
      // A role grant is only valid with a same-commit, reviewed LGU credential record.
      // getAfter + verifiedAt == request.time requires a fresh review in the same batch,
      // rather than a stale record from an earlier promotion.
      function hasFreshLguCredentialReview() {
        let review = getAfter(
          /databases/$(database)/documents/lguAdminCredentialReviews/$(uid)
        ).data;
        return review.targetUid == uid
          && review.reviewStatus == 'verified'
          && review.verifiedBy == request.auth.uid
          && review.verifiedAt == request.time
          && review.accountEmail == request.resource.data.email;
      }
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.get("email", "") == request.resource.data.email
        && validInitialResidentInputs()
        && !request.resource.data.email.matches("(?i).*@(?:[a-z0-9-]+[.])*en2ch[.](?:com|co)")
        && !blockedTempMailOrgAlias(request.resource.data.email)
        && request.resource.data.keys().hasAll([
          "uid", "email", "fullName", "firstName", "lastName",
          "age", "phoneNumber", "barangay", "occupationCategory"
        ])
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 100
        // Already enforced by validInitialResidentInputs(); uid checked above.
        && request.resource.data.province in [
          'Bulacan',
          'BULACAN',
          'Province of Bulacan'
        ]
        && request.resource.data.city in [
          'City of San Jose del Monte',
          'CITY OF SAN JOSE DEL MONTE',
          'City of San Jose Del Monte',
          'San Jose del Monte',
          'San Jose Del Monte',
          'SAN JOSE DEL MONTE'
        ]
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'lastName',
          'firstName',
          'middleName',
          'age',
          'dateOfBirth',
          'email',
          'phoneNumber',
          'region',
          'province',
          'city',
          'barangay',
          'address',
          'occupationCategory',
          'occupationSpecialization',
          'occupationOther',
          'occupation',
          'skills',
          'skillOther',
          'availability',
          'role',
          'requestedRole',
          'primaryRole',
          'residentAccess',
          'volunteerAccess',
          'volunteerStatus',
          'activeMode',
          'status',
          'identityStatus',
          'identityVerified',
          'profilePictureUrl',
          'createdAt'
        ])
        // Missing DOB on legacy entry paths defaults to a valid placeholder.
        // Present DOB must follow the canonical calendar-date format.
        && request.resource.data.get('dateOfBirth', '2000-01-01').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.role == 'resident'
        && request.resource.data.status == 'approved'
        && request.resource.data.requestedRole == 'resident'
        && request.resource.data.primaryRole == 'resident'
        && request.resource.data.residentAccess == true
        && request.resource.data.volunteerAccess == false
        && request.resource.data.volunteerStatus == 'not_applied'
        && request.resource.data.activeMode == 'resident'
        && request.resource.data.identityStatus == 'basic'
        && request.resource.data.identityVerified == false
        && request.resource.data.skills is list
        && request.resource.data.skills.size() == 0
        && request.resource.data.skillOther == ''
        && request.resource.data.availability is list
        && request.resource.data.availability.size() == 0
        && request.resource.data.createdAt is timestamp;
      // Staff applications never receive operational permissions at signup.
      // Only a separately verified Super Admin can promote the pending account.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.get('email', '') == request.resource.data.email
        && request.resource.data.keys().hasOnly([
          'uid','email','fullName','age','phoneNumber','role','status',
          'residentAccess','volunteerAccess','region','province','city',
          'barangay','lguOffice','lguPosition','appointmentReference','createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'applicant'
        && request.resource.data.status == 'pending_review'
        && request.resource.data.residentAccess == false
        && request.resource.data.volunteerAccess == false
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 5
        && request.resource.data.fullName.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.lguOffice is string
        && request.resource.data.lguOffice.size() >= 3
        && request.resource.data.lguOffice.size() <= 160
        && request.resource.data.lguPosition is string
        && request.resource.data.lguPosition.size() >= 3
        && request.resource.data.lguPosition.size() <= 120
        && request.resource.data.appointmentReference is string
        && request.resource.data.appointmentReference.size() >= 5
        && request.resource.data.appointmentReference.size() <= 160
        && request.resource.data.province == 'Bulacan'
        && request.resource.data.city == 'City of San Jose del Monte'
        && request.resource.data.createdAt == request.time;
      // Direct privileged account creation is intentionally disabled.
      // Verified LGU staff must submit a pending application and be promoted.
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdminOrSuperAdmin()
        );
      allow list: if isAdminOrSuperAdmin();
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'fullName',
            'lastName',
            'firstName',
            'middleName',
            'age',
            'phoneNumber',
            'region',
            'province',
            'city',
            'barangay',
            'address',
            'occupationCategory',
            'occupationSpecialization',
            'occupationOther',
            'occupation',
            'skills',
            'skillOther',
            'availability',
            'profilePictureUrl'
          ])
        && (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'province'
            ])
          || request.resource.data.province in [
            'Bulacan',
            'BULACAN',
            'Province of Bulacan'
          ]
        )
        && (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'city'
            ])
          || request.resource.data.city in [
            'City of San Jose del Monte',
            'CITY OF SAN JOSE DEL MONTE',
            'City of San Jose Del Monte',
            'San Jose del Monte',
            'San Jose Del Monte',
            'SAN JOSE DEL MONTE'
          ]
        );
      allow update: if signedIn()
        && request.auth.uid == uid
        && approved()
        && (
          !('identityStatus' in resource.data)
          || resource.data.identityStatus in [
            'basic',
            'failed',
            'retry_required'
          ]
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'identityStatus',
            'identityVerified',
            'identitySubmittedAt',
            'identityVerifiedAt',
            'identityVerifiedBy',
            'identityFailureReason'
          ])
        && request.resource.data.identityStatus == 'pending'
        && request.resource.data.identityVerified == false
        && request.resource.data.identitySubmittedAt is timestamp
        && request.resource.data.identityVerifiedAt == null
        && request.resource.data.identityVerifiedBy == ''
        && request.resource.data.identityFailureReason == ''
        && identitySubmissionAfter().uid == uid
        && identitySubmissionAfter().status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == uid
        && approved()
        && hasVerifiedIdentity(resource.data)
        && resource.data.residentAccess == true
        && resource.data.volunteerAccess == false
        && resource.data.volunteerStatus in [
          'not_applied',
          'rejected'
        ]
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'volunteerStatus'
          ])
        && request.resource.data.volunteerAccess == false
        && request.resource.data.volunteerStatus == 'pending'
        && request.resource.data.activeMode == 'resident'
        && volunteerApplicationAfter().uid == uid
        && volunteerApplicationAfter().status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == uid
        && approved()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'activeMode'
          ])
        && request.resource.data.activeMode in [
          'resident',
          'volunteer'
        ]
        && (
          (
            request.resource.data.activeMode == 'resident'
            && hasResidentAccess()
          )
          || (
            request.resource.data.activeMode == 'volunteer'
            && hasVolunteerAccess()
          )
        );
      allow update: if isAdmin()
        && resource.data.role in [
          'resident',
          'volunteer'
        ]
        && resource.data.identityStatus == 'pending'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'identityStatus',
            'identityVerified',
            'identityVerifiedAt',
            'identityVerifiedBy',
            'identityFailureReason'
          ])
        && request.resource.data.identityVerifiedBy == request.auth.uid
        && (
          (
            request.resource.data.identityStatus == 'verified'
            && request.resource.data.identityVerified == true
            && request.resource.data.identityVerifiedAt is timestamp
            && request.resource.data.identityFailureReason == ''
            && identitySubmissionAfter().status == 'verified'
            && identitySubmissionAfter().reviewedBy == request.auth.uid
          )
          ||
          (
            request.resource.data.identityStatus == 'failed'
            && request.resource.data.identityVerified == false
            && request.resource.data.identityVerifiedAt == null
            && request.resource.data.identityFailureReason is string
            && request.resource.data.identityFailureReason.size() >= 3
            && request.resource.data.identityFailureReason.size() <= 500
            && identitySubmissionAfter().status == 'failed'
            && identitySubmissionAfter().reviewedBy == request.auth.uid
          )
        );
      allow update: if isAdmin()
        && resource.data.role in [
          'resident',
          'volunteer'
        ]
        && resource.data.status == 'approved'
        && hasVerifiedIdentity(resource.data)
        && resource.data.residentAccess == true
        && resource.data.volunteerAccess == false
        && resource.data.volunteerStatus in [
          'not_applied',
          'pending',
          'rejected'
        ]
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'volunteerAccess',
            'volunteerStatus',
            'activeMode',
            'volunteerReviewedAt',
            'volunteerReviewedBy'
          ])
        && request.resource.data.residentAccess == true
        && request.resource.data.activeMode == 'resident'
        && request.resource.data.volunteerReviewedAt is timestamp
        && request.resource.data.volunteerReviewedBy == request.auth.uid
        && request.resource.data.volunteerStatus in [
          'approved',
          'rejected'
        ]
        && (
          (
            request.resource.data.volunteerStatus == 'approved'
            && request.resource.data.volunteerAccess == true
          )
          ||
          (
            request.resource.data.volunteerStatus == 'rejected'
            && request.resource.data.volunteerAccess == false
          )
        )
        && volunteerApplicationAfter().status
          == request.resource.data.volunteerStatus;
      allow update: if isAdmin()
        && resource.data.role in [
          'resident',
          'volunteer'
        ]
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'reviewedAt',
            'reviewedBy',
            'rejectedReason'
          ])
        && request.resource.data.status in [
          'approved',
          'suspended'
        ]
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectedReason is string;
      allow update: if isSuperAdmin()
        && request.auth.uid != uid
        && resource.data.role != 'superadmin'
        && (
          (
            resource.data.role == 'applicant'
            && resource.data.status == 'pending_review'
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'approved'
            && request.resource.data.adminStatus == 'active'
            && hasFreshLguCredentialReview()
            && request.resource.data.adminCreatedBy == request.auth.uid
            && request.resource.data.adminUpdatedBy == request.auth.uid
            && request.resource.data.adminCreatedAt is timestamp
            && request.resource.data.adminUpdatedAt is timestamp
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'previousRole',
                'previousPrimaryRole',
                'role',
                'adminStatus',
                'status',
                'adminCreatedAt',
                'adminCreatedBy',
                'adminUpdatedAt',
                'adminUpdatedBy'
              ])
          )
          || (
            resource.data.role == 'admin'
            && request.resource.data.role == 'admin'
            && request.resource.data.status in [
              'approved',
              'suspended'
            ]
            && request.resource.data.adminStatus in [
              'active',
              'suspended'
            ]
            && (
              (
                request.resource.data.status == 'approved'
                && request.resource.data.adminStatus == 'active'
              )
              || (
                request.resource.data.status == 'suspended'
                && request.resource.data.adminStatus == 'suspended'
              )
            )
            && request.resource.data.adminUpdatedBy == request.auth.uid
            && request.resource.data.adminUpdatedAt is timestamp
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'adminStatus',
                'adminUpdatedAt',
                'adminUpdatedBy'
              ])
          )
          || (
            resource.data.role == 'admin'
            && request.resource.data.role in [
              'resident',
              'volunteer'
            ]
            && request.resource.data.primaryRole in [
              'resident',
              'volunteer'
            ]
            && request.resource.data.status == 'approved'
            && request.resource.data.adminStatus == 'suspended'
            && request.resource.data.adminUpdatedBy == request.auth.uid
            && request.resource.data.adminRevokedBy == request.auth.uid
            && request.resource.data.adminUpdatedAt is timestamp
            && request.resource.data.adminRevokedAt is timestamp
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'role',
                'primaryRole',
                'status',
                'adminStatus',
                'adminUpdatedAt',
                'adminUpdatedBy',
                'adminRevokedAt',
                'adminRevokedBy'
              ])
          )
        );
      allow update: if isAdmin()
        && resource.data.role == 'applicant'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'role',
            'requestedRole',
            'primaryRole',
            'residentAccess',
            'volunteerAccess',
            'volunteerStatus',
            'activeMode',
            'status',
            'reviewedAt',
            'reviewedBy',
            'rejectedReason',
            'volunteerReviewedAt',
            'volunteerReviewedBy'
          ])
        && request.resource.data.role in [
          'applicant',
          'resident',
          'volunteer'
        ]
        && request.resource.data.status in [
          'pending_review',
          'approved',
          'rejected',
          'suspended'
        ]
        && (
          !('activeMode' in request.resource.data)
          || request.resource.data.activeMode in [
            'resident',
            'volunteer'
          ]
        )
        && (
          !('primaryRole' in request.resource.data)
          || request.resource.data.primaryRole in [
            'resident',
            'volunteer'
          ]
        )
        && (
          !('residentAccess' in request.resource.data)
          || request.resource.data.residentAccess is bool
        )
        && (
          !('volunteerAccess' in request.resource.data)
          || request.resource.data.volunteerAccess is bool
        )
        && (
          !('volunteerStatus' in request.resource.data)
          || request.resource.data.volunteerStatus in [
            'not_applied',
            'pending',
            'approved',
            'rejected'
          ]
        )
        && (
          !('volunteerAccess' in request.resource.data)
          || request.resource.data.volunteerAccess == false
          || (
            'volunteerStatus' in request.resource.data
            && request.resource.data.volunteerStatus == 'approved'
          )
        )
        && (
          !('activeMode' in request.resource.data)
          || request.resource.data.activeMode == 'resident'
          || request.resource.data.role == 'volunteer'
          || (
            'volunteerAccess' in request.resource.data
            && request.resource.data.volunteerAccess == true
          )
        );
      allow delete: if false;
    }
    match /lguDutyStatus/{uid} {


      allow read: if isAdminOrSuperAdmin()
        || (isLguPersonnel() && request.auth.uid == uid);
      allow write: if false;
    }
    match /lguAttendance/{attendanceId} {


      allow read: if isAdminOrSuperAdmin()
        || (isLguPersonnel() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /lguAssignments/{assignmentId} {


      allow read: if isAdminOrSuperAdmin()
        || (
          isLguPersonnel()
          && resource.data.personnelUid == request.auth.uid
        );
      allow write: if false;
    }
    match /address_regions/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /systemSettings/{settingId} {
      allow read: if settingId == 'public';
      allow create, update: if isSuperAdmin()
        && settingId == 'public'
        && request.resource.data.keys().hasOnly([
          'cityName',
          'emergencyHotline',
          'supportEmail',
          'publicServiceNotice',
          'liveLocationRetentionHours',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.cityName is string
        && request.resource.data.cityName.size() >= 3
        && request.resource.data.cityName.size() <= 120
        && request.resource.data.emergencyHotline is string
        && request.resource.data.emergencyHotline.size() >= 3
        && request.resource.data.emergencyHotline.size() <= 160
        && request.resource.data.supportEmail is string
        && request.resource.data.supportEmail.size() <= 160
        && request.resource.data.publicServiceNotice is string
        && request.resource.data.publicServiceNotice.size() >= 10
        && request.resource.data.publicServiceNotice.size() <= 500
        && request.resource.data.liveLocationRetentionHours is int
        && request.resource.data.liveLocationRetentionHours >= 1
        && request.resource.data.liveLocationRetentionHours <= 720
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /announcements/{announcementId} {
      // Every community-wide notice is published immediately on creation.
      // List queries cannot prove a resource timestamp <= request.time, so
      // authorize the same explicit audience constraint used by readers.
      // Keep verification, approved status, active staff policy unchanged.
      allow read: if isAdminOrSuperAdmin()
        || (approved() && resource.data.audience == 'all');
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'message',
          'linkUrl',
          'imageUrl',
          'audience',
          'priority',
          'publishAt',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.linkUrl is string
        && request.resource.data.imageUrl is string
        && request.resource.data.priority in [
          'normal',
          'urgent'
        ]
        && request.resource.data.publishAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.audience == "all";
      allow update: if isAdmin()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.audience == resource.data.audience
        && request.resource.data.publishAt == resource.data.publishAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin()
        && resource.data.createdBy == request.auth.uid;
    }
    match /identityVerifications/{uid} {
      function userAfterReview() {
        return getAfter(
          /databases/$(database)/documents/users/$(uid)
        ).data;
      }
      function validPendingIdentitySubmission() {
        let user = userAfterReview();
        return request.resource.data.idType in [
          'national_id',
          'drivers_license',
          'passport',
          'other_government_id'
        ]
        && request.resource.data.idDocumentUrl is string
        && request.resource.data.idDocumentUrl.size() >= 10
        && request.resource.data.idDocumentUrl.size() <= 2048
        && request.resource.data.selfieUrl is string
        && request.resource.data.selfieUrl.size() >= 10
        && request.resource.data.selfieUrl.size() <= 2048
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == ''
        && request.resource.data.reviewNote == ''
        && user.identityStatus == 'pending'
        && user.identityVerified == false;
      }
      allow create: if signedIn()
        && request.auth.uid == uid
        && approved()
        && hasResidentAccess()
        && (
          !('identityStatus' in profile())
          || profile().identityStatus in [
            'basic',
            'failed'
          ]
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'idType',
          'idDocumentUrl',
          'selfieUrl',
          'status',
          'submittedAt',
          'updatedAt',
          'reviewedAt',
          'reviewedBy',
          'reviewNote'
        ])
        && request.resource.data.uid == uid
        && validPendingIdentitySubmission();
      allow update: if signedIn()
        && request.auth.uid == uid
        && approved()
        && resource.data.uid == uid
        && resource.data.status == 'failed'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'idType',
            'idDocumentUrl',
            'selfieUrl',
            'status',
            'submittedAt',
            'updatedAt',
            'reviewedAt',
            'reviewedBy',
            'reviewNote'
          ])
        && validPendingIdentitySubmission();
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );
      allow list: if isAdmin();
      allow update: if isAdmin()
        && resource.data.uid == uid
        && resource.data.status == 'pending'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'reviewedAt',
            'reviewedBy',
            'reviewNote',
            'updatedAt'
          ])
        && request.resource.data.status in [
          'verified',
          'failed'
        ]
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 500
        && request.resource.data.updatedAt is timestamp
        && userAfterReview().identityStatus
          == request.resource.data.status
        && (
          (
            request.resource.data.status == 'verified'
            && userAfterReview().identityVerified == true
          )
          ||
          (
            request.resource.data.status == 'failed'
            && userAfterReview().identityVerified == false
            && request.resource.data.reviewNote.size() >= 3
          )
        );
      allow delete: if false;
    }
    match /volunteerApplications/{uid} {



      function validVolunteerApplicationPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'uid',
          'source',
          'applicantType',
          'requestedRole',
          'fullName',
          'email',
          'barangay',
          'phone',
          'phoneNumber',
          'occupationCategory',
          'occupationSpecialization',
          'occupationOther',
          'skills',
          'availability',
          'experienceTraining',
          'preferredActivity',
          'emergencyContact',
          'motivation',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && rd.uid == uid
        && rd.source in [
          'profile_application',
          'resident_application'
        ]
        && rd.applicantType == 'existing_resident'
        && rd.requestedRole == 'volunteer'
        && rd.fullName is string
        && rd.fullName.size() >= 1
        && rd.fullName.size() <= 120
        && rd.email is string
        && rd.email.size() <= 160
        && rd.barangay is string
        && rd.barangay.size() <= 120
        && rd.phone is string
        && rd.phone.size() <= 30
        && rd.phoneNumber is string
        && rd.phoneNumber.size() >= 8
        && rd.phoneNumber.size() <= 30
        && rd.occupationCategory is string
        && rd.occupationCategory.size() <= 120
        && rd.occupationSpecialization is string
        && rd.occupationSpecialization.size() <= 160
        && rd.occupationOther is string
        && rd.occupationOther.size() <= 160
        && rd.skills is list
        && rd.skills.size() >= 1
        && rd.skills.size() <= 20
        && rd.availability is list
        && rd.availability.size() >= 1
        && rd.availability.size() <= 20
        && rd.experienceTraining is string
        && rd.experienceTraining.size() >= 5
        && rd.experienceTraining.size() <= 1500
        && rd.preferredActivity is string
        && rd.preferredActivity.size() >= 1
        && rd.preferredActivity.size() <= 160
        && rd.emergencyContact is string
        && rd.emergencyContact.size() <= 60
        && rd.motivation is string
        && rd.motivation.size() >= 15
        && rd.motivation.size() <= 2000
        && rd.status == 'pending'
        && rd.createdAt is timestamp
        && rd.updatedAt is timestamp;
      }
      allow create: if isVerifiedResident()
        && request.auth.uid == uid
        && profile().volunteerAccess == false
        && profile().volunteerStatus in [
          'not_applied',
          'rejected'
        ]
        && validVolunteerApplicationPayload();
      allow update: if isVerifiedResident()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && resource.data.status == 'rejected'
        && profile().volunteerAccess == false
        && profile().volunteerStatus == 'rejected'
        && validVolunteerApplicationPayload();
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdminOrSuperAdmin()
        );
      allow update: if isAdmin()
        && resource.data.uid == uid
        && resource.data.status == 'pending'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'volunteerAccess',
            'activeMode',
            'reviewedAt',
            'reviewedBy',
            'rejectedReason'
          ])
        && request.resource.data.status in [
          'approved',
          'rejected'
        ]
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.volunteerAccess == true
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.volunteerAccess == false
          )
        )
        && request.resource.data.activeMode == 'resident'
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectedReason is string
        && request.resource.data.rejectedReason.size() <= 500;
      allow delete: if false;
    }
    match /assistanceEvidenceAssets/{evidenceId} {
      allow read, write: if false;
    }
    match /assistanceVerificationReviews/{requestId} {
      function sourceAssistanceExists() {
        return exists(
          /databases/$(database)/documents/assistanceRequests/$(requestId)
        );
      }
      function sourceAssistance() {
        return get(
          /databases/$(database)/documents/assistanceRequests/$(requestId)
        ).data;
      }
      function sourceNeedsFacilityVerification() {
        return sourceAssistance().category in [
          'medical_health',
          'surgery_treatment',
          'cancer_serious_illness',
          'animal_pet_welfare'
        ];
      }
      function sourceNeedsCostVerification() {
        return sourceAssistance().estimatedAmount > 0;
      }
      function validPrivateCoordinates() {
        return (
          request.resource.data.privateLatitude == null
          && request.resource.data.privateLongitude == null
        )
        || (
          request.resource.data.privateLatitude is number
          && request.resource.data.privateLatitude >= -90
          && request.resource.data.privateLatitude <= 90
          && request.resource.data.privateLongitude is number
          && request.resource.data.privateLongitude >= -180
          && request.resource.data.privateLongitude <= 180
        );
      }
      function validFacilityVerificationState() {
        let rd = request.resource.data;
        return rd.facilityName is string
          && rd.facilityName.size() <= 160
          && rd.facilityType is string
          && rd.facilityType.size() <= 80
          && rd.facilityDepartment is string
          && rd.facilityDepartment.size() <= 160
          && rd.professionalName is string
          && rd.professionalName.size() <= 160
          && rd.facilityReferenceNumber is string
          && rd.facilityReferenceNumber.size() <= 160
          && rd.facilityVerificationMethod in [
            'not_applicable',
            'official_phone',
            'official_email',
            'official_record',
            'in_person',
            'other'
          ]
          && rd.facilityVerifiedWith is string
          && rd.facilityVerifiedWith.size() <= 160
          && (
            rd.facilityVerifiedAt == null
            || rd.facilityVerifiedAt is timestamp
          )
          && rd.facilityNotes is string
          && rd.facilityNotes.size() <= 2000
          && (
            !sourceNeedsFacilityVerification()
            || rd.facilityVerificationRequired == true
          )
          && (
            (
              rd.facilityVerificationRequired == false
              && rd.facilityVerificationStatus == 'not_required'
              && rd.facilityVerifiedAt == null
            )
            || (
              rd.facilityVerificationRequired == true
              && rd.facilityVerificationStatus in [
                'pending',
                'confirmed',
                'unable_to_confirm',
                'inconsistent'
              ]
            )
          )
          && (
            rd.facilityVerificationStatus != 'confirmed'
            || (
              rd.facilityName.size() >= 2
              && rd.facilityVerificationMethod
                != 'not_applicable'
              && rd.facilityVerifiedAt is timestamp
            )
          );
      }
      function validCostVerificationState() {
        let rd = request.resource.data;
        return rd.residentEstimatedAmount is number
          && rd.residentEstimatedAmount >= 0
          && rd.residentEstimatedAmount <= 100000000
          && rd.residentEstimatedAmount
            == sourceAssistance().estimatedAmount
          && rd.verifiedGrossCost is number
          && rd.verifiedGrossCost >= 0
          && rd.verifiedGrossCost <= 100000000
          && rd.confirmedExistingAssistanceAmount is number
          && rd.confirmedExistingAssistanceAmount >= 0
          && rd.confirmedExistingAssistanceAmount <= 100000000
          && rd.verifiedUncoveredAmount is number
          && rd.verifiedUncoveredAmount >= 0
          && rd.verifiedUncoveredAmount <= 100000000
          && rd.costReferenceNumber is string
          && rd.costReferenceNumber.size() <= 160
          && rd.costNotes is string
          && rd.costNotes.size() <= 2000
          && (
            !sourceNeedsCostVerification()
            || rd.costVerificationRequired == true
          )
          && (
            (
              rd.costVerificationRequired == false
              && rd.costVerificationStatus == 'not_required'
              && rd.verifiedGrossCost == 0
              && rd.confirmedExistingAssistanceAmount == 0
              && rd.verifiedUncoveredAmount == 0
            )
            || (
              rd.costVerificationRequired == true
              && rd.costVerificationStatus in [
                'pending',
                'confirmed',
                'inconsistent'
              ]
            )
          )
          && (
            rd.costVerificationStatus != 'confirmed'
            || (
              rd.verifiedGrossCost > 0
              && rd.confirmedExistingAssistanceAmount
                <= rd.verifiedGrossCost
              && rd.verifiedUncoveredAmount
                == rd.verifiedGrossCost
                  - rd.confirmedExistingAssistanceAmount
            )
          );
      }
      function validResidencyVerificationState() {
        let rd = request.resource.data;
        return rd.residencyVerificationStatus in [
            'pending',
            'verified',
            'unable_to_verify',
            'inconsistent',
            'not_required'
          ]
          && rd.residencyVerificationMethod in [
            'not_applicable',
            'profile_address',
            'barangay_confirmation',
            'resident_confirmation',
            'site_visit',
            'other'
          ]
          && rd.privateAddressSnapshot is string
          && rd.privateAddressSnapshot.size() <= 300
          && validPrivateCoordinates()
          && (
            rd.locationVerifiedAt == null
            || rd.locationVerifiedAt is timestamp
          )
          && rd.locationVerifiedBy is string
          && rd.locationVerifiedBy.size() <= 160
          && rd.residencyNotes is string
          && rd.residencyNotes.size() <= 2000
          && (
            rd.residencyVerificationStatus != 'verified'
            || (
              rd.residencyVerificationMethod
                != 'not_applicable'
              && rd.locationVerifiedAt is timestamp
              && rd.locationVerifiedBy == request.auth.uid
            )
          );
      }
      function validOptionalVerificationState() {
        let rd = request.resource.data;
        return (
            rd.videoVerificationAt == null
            || rd.videoVerificationAt is timestamp
          )
          && rd.videoVerificationNotes is string
          && rd.videoVerificationNotes.size() <= 2000
          && (
            rd.siteVisitAt == null
            || rd.siteVisitAt is timestamp
          )
          && rd.siteVisitBy is string
          && rd.siteVisitBy.size() <= 160
          && rd.siteVisitNotes is string
          && rd.siteVisitNotes.size() <= 2000
          && (
            (
              rd.videoVerificationRequired == false
              && rd.videoVerificationStatus == 'not_required'
              && rd.videoVerificationAt == null
            )
            || (
              rd.videoVerificationRequired == true
              && rd.videoVerificationStatus in [
                'pending',
                'requested',
                'completed',
                'unable_to_complete'
              ]
            )
          )
          && (
            (
              rd.siteVisitRequired == false
              && rd.siteVisitStatus == 'not_required'
              && rd.siteVisitAt == null
              && rd.siteVisitBy == ''
            )
            || (
              rd.siteVisitRequired == true
              && rd.siteVisitStatus in [
                'pending',
                'scheduled',
                'completed',
                'unable_to_complete'
              ]
            )
          );
      }
      function validReviewPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'requestId',
          'requesterUid',
          'category',
          'reviewStatus',
          'documentConsistencyStatus',
          'documentConsistencyNotes',
          'duplicateCheckStatus',
          'duplicateRequestIds',
          'duplicateCheckNotes',
          'beneficiaryCheckStatus',
          'beneficiaryCheckNotes',
          'facilityVerificationRequired',
          'facilityVerificationStatus',
          'facilityName',
          'facilityType',
          'facilityDepartment',
          'professionalName',
          'facilityReferenceNumber',
          'facilityVerificationMethod',
          'facilityVerifiedWith',
          'facilityVerifiedAt',
          'facilityNotes',
          'costVerificationRequired',
          'residentEstimatedAmount',
          'verifiedGrossCost',
          'confirmedExistingAssistanceAmount',
          'verifiedUncoveredAmount',
          'costVerificationStatus',
          'costReferenceNumber',
          'costNotes',
          'residencyVerificationStatus',
          'residencyVerificationMethod',
          'privateAddressSnapshot',
          'privateLatitude',
          'privateLongitude',
          'locationVerifiedAt',
          'locationVerifiedBy',
          'residencyNotes',
          'videoVerificationRequired',
          'videoVerificationStatus',
          'videoVerificationAt',
          'videoVerificationNotes',
          'siteVisitRequired',
          'siteVisitStatus',
          'siteVisitAt',
          'siteVisitBy',
          'siteVisitNotes',
          'riskFlags',
          'internalNotes',
          'finalDecision',
          'finalDecisionReason',
          'finalDecisionAt',
          'finalDecisionBy',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && sourceAssistanceExists()
        && rd.requestId == requestId
        && rd.requesterUid == sourceAssistance().requesterUid
        && rd.category == sourceAssistance().category
        && rd.documentConsistencyStatus in [
          'pending',
          'consistent',
          'inconsistent',
          'needs_more_information'
        ]
        && rd.documentConsistencyNotes is string
        && rd.documentConsistencyNotes.size() <= 2000
        && rd.duplicateCheckStatus in [
          'pending',
          'clear',
          'potential_duplicate',
          'confirmed_duplicate'
        ]
        && rd.duplicateRequestIds is list
        && rd.duplicateRequestIds.size() <= 20
        && rd.duplicateCheckNotes is string
        && rd.duplicateCheckNotes.size() <= 2000
        && rd.beneficiaryCheckStatus in [
          'pending',
          'confirmed',
          'needs_more_information',
          'inconsistent'
        ]
        && rd.beneficiaryCheckNotes is string
        && rd.beneficiaryCheckNotes.size() <= 2000
        && validFacilityVerificationState()
        && validCostVerificationState()
        && validResidencyVerificationState()
        && validOptionalVerificationState()
        && rd.riskFlags is list
        && rd.riskFlags.size() <= 20
        && rd.internalNotes is string
        && rd.internalNotes.size() <= 3000
        && rd.finalDecisionReason is string
        && rd.finalDecisionReason.size() <= 2000
        && rd.finalDecisionBy.size() <= 160
        && rd.createdAt is timestamp
        && rd.createdBy is string
        && rd.createdBy.size() <= 160
        && rd.updatedAt is timestamp
        && rd.updatedBy == request.auth.uid;
      }
      function validFinalDecisionState() {
        let rd = request.resource.data;
        return (
          rd.finalDecision == 'pending'
          && rd.reviewStatus == 'in_progress'
          && rd.finalDecisionReason == ''
          && rd.finalDecisionAt == null
          && rd.finalDecisionBy == ''
        )
        || (
          rd.finalDecision == 'needs_more_information'
          && rd.reviewStatus == 'needs_more_information'
          && rd.finalDecisionReason.size() >= 3
          && rd.finalDecisionAt is timestamp
          && rd.finalDecisionBy == request.auth.uid
        )
        || (
          rd.finalDecision == 'verified'
          && rd.reviewStatus == 'verified'
          && rd.documentConsistencyStatus == 'consistent'
          && rd.duplicateCheckStatus == 'clear'
          && rd.beneficiaryCheckStatus == 'confirmed'
          && rd.residencyVerificationStatus == 'verified'
          && (
            rd.facilityVerificationRequired == false
            || rd.facilityVerificationStatus == 'confirmed'
          )
          && (
            rd.costVerificationRequired == false
            || rd.costVerificationStatus == 'confirmed'
          )
          && rd.videoVerificationStatus in [
            'not_required',
            'completed'
          ]
          && rd.siteVisitStatus in [
            'not_required',
            'completed'
          ]
          && rd.riskFlags.size() == 0
          && rd.finalDecisionAt is timestamp
          && rd.finalDecisionBy == request.auth.uid
        )
        || (
          rd.finalDecision == 'rejected'
          && rd.reviewStatus == 'rejected'
          && rd.finalDecisionReason.size() >= 3
          && rd.finalDecisionAt is timestamp
          && rd.finalDecisionBy == request.auth.uid
        );
      }
      allow create: if isAdmin()
        && validReviewPayload()
        && request.resource.data.reviewStatus == 'in_progress'
        && request.resource.data.finalDecision == 'pending'
        && request.resource.data.finalDecisionReason == ''
        && request.resource.data.finalDecisionAt == null
        && request.resource.data.finalDecisionBy == ''
        && request.resource.data.createdBy == request.auth.uid
        && validFinalDecisionState();
      allow update: if isAdmin()
        && resource.data.finalDecision in [
          'pending',
          'needs_more_information'
        ]
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && validReviewPayload()
        && validFinalDecisionState();
      allow read: if isAdminOrSuperAdmin();
      allow delete: if false;
    }
    match /assistanceRequests/{requestId} {



      function verificationReviewExists() {
        return exists(
          /databases/$(database)/documents/assistanceVerificationReviews/$(requestId)
        );
      }
      function verificationReview() {
        return get(
          /databases/$(database)/documents/assistanceVerificationReviews/$(requestId)
        ).data;
      }
      function validAssistanceCategoryPair() {
        return (
          request.resource.data.requestGroup == 'disaster_recovery'
          && request.resource.data.category == 'disaster_recovery'
        )
        || (
          request.resource.data.requestGroup == 'community_need'
          && request.resource.data.category in [
            'medical_health',
            'surgery_treatment',
            'cancer_serious_illness',
            'animal_pet_welfare',
            'elderly_assistance',
            'homeless_basic_needs',
            'other_community_assistance'
          ]
        );
      }
      function validSecureAssistanceDocument(document) {
        return document.keys().hasOnly([
            'documentType',
            'label',
            'url',
            'fileName'
          ])
          && document.documentType.matches('^(?:d(?:amage_evidence|iagnosis_document)|ba(?:rangay_(?:incident_reference|social_welfare_reference)|sic_need_evidence)|medical_certificate|hospital_estimate|other_(?:(?:medical|treatment|illness|animal)_support|supporting_evidence)|treatment_(?:estimate|plan_or_bill)|animal_case_photo|vet_assessment|elderly_(?:need_evidence|supporting_document))$')
          && document.label is string
