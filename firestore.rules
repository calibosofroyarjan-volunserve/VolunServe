            'resolved'
          ];
      }
      function canReadResidentCase() {
        let caseData = lguCaseForRead();
        return caseData.reporterUid == request.auth.uid
          && caseData.status in [
            'reported',
            'validated',
            'assigned',
            'in_progress'
          ];
      }
      function canReadVolunteerSupportCase() {
        let caseData = lguCaseForRead();
        let assignmentData = lguVolunteerAssignmentForRead();
        return 'activeVolunteerSupportUid' in caseData
          && caseData.activeVolunteerSupportUid
            == request.auth.uid
          && 'activeVolunteerSupportAssignmentId' in caseData
          && caseData.activeVolunteerSupportAssignmentId is string
          && caseData.activeVolunteerSupportAssignmentId.size() > 0
          && assignmentData.caseId == caseId
          && assignmentData.volunteerId
            == request.auth.uid
          && assignmentData.status in [
            'accepted',
            'responding',
            'on_site'
          ]
          && caseData.status in [
            'validated',
            'assigned',
            'in_progress'
          ];
      }
      allow read: if isAdmin()
        || (isLguPersonnel() && canReadAssignedLguCase())
        || (isResident() && canReadResidentCase())
        || (isVolunteer() && canReadVolunteerSupportCase());
      allow create, update: if isOperationalLgu()
        && validLguLocationPayload()
        && lguCaseForWrite().activeLguResponderUid == request.auth.uid
        && (
          isAdmin()
          || (
            'assignedLguPersonnelIds' in lguCaseForWrite()
            && lguCaseForWrite().assignedLguPersonnelIds is list
            && request.auth.uid in lguCaseForWrite().assignedLguPersonnelIds
          )
        )
        && lguCaseForWrite().status in [
          'reported',
          'validated',
          'assigned',
          'in_progress'
        ];
      allow delete: if (
          isOperationalLgu()
          && resource.data.responderUid == request.auth.uid
        )
        || (
          isAdmin()
          && lguCaseForRead().status in ['resolved', 'closed']
        );
    }
    match /residentResponseLocations/{uid} {


      function residentAssignmentForWrite() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }
      function residentCaseForWrite() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }
      function residentAssignmentForRead() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(resource.data.assignmentId)
        ).data;
      }
      function residentCaseForRead() {
        return get(
          /databases/$(database)/documents/disasterCases/$(resource.data.caseId)
        ).data;
      }
      function validResidentLocationPayload() {
        let rd = request.resource.data;
        return rd.keys().hasOnly([
          'residentId',
          'responseMode',
          'assignmentId',
          'caseId',
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])
        && rd.residentId == request.auth.uid
        && rd.responseMode in [
          'lgu',
          'volunteer'
        ]
        && rd.assignmentId is string
        && (
          (
            rd.responseMode == 'lgu'
            && rd.assignmentId == ''
          )
          || (
            rd.responseMode == 'volunteer'
            && rd.assignmentId.size() > 0
          )
        )
        && rd.caseId is string
        && rd.caseId.size() > 0
        && rd.latitude is number
        && rd.latitude >= -90
        && rd.latitude <= 90
        && rd.longitude is number
        && rd.longitude >= -180
        && rd.longitude <= 180
        && (
          rd.accuracy == null
          || rd.accuracy is number
        )
        && rd.updatedAt is timestamp;
      }
      function validResidentLiveMissionForWrite() {
        return residentCaseForWrite().reporterUid
          == request.auth.uid
          && residentCaseForWrite().status in [
            'reported',
            'validated',
            'assigned',
            'in_progress'
          ]
          && (
            (
              request.resource.data.responseMode == 'lgu'
              && request.resource.data.assignmentId == ''
            )
            || (
              request.resource.data.responseMode == 'volunteer'
              && residentCaseForWrite().status in [
                'assigned',
                'in_progress'
              ]
              && residentAssignmentForWrite().caseId
                == request.resource.data.caseId
              && residentAssignmentForWrite().volunteerId is string
              && residentAssignmentForWrite().volunteerId.size() > 0
              && residentAssignmentForWrite().status in [
                'accepted',
                'responding',
                'on_site'
              ]
            )
          );
      }
      allow read: if isAdmin()
        || (
          isLguPersonnel()
          && 'assignedLguPersonnelIds' in residentCaseForRead()
          && residentCaseForRead().assignedLguPersonnelIds is list
          && request.auth.uid in residentCaseForRead().assignedLguPersonnelIds
          && residentCaseForRead().status in [
            'validated',
            'assigned',
            'in_progress'
          ]
        )
        || (
          isResident()
          && request.auth.uid == uid
          && resource.data.residentId == request.auth.uid
        )
        || (
          isVolunteer()
          && resource.data.responseMode == 'volunteer'
          && resource.data.assignmentId is string
          && resource.data.assignmentId.size() > 0
          && residentAssignmentForRead().volunteerId
            == request.auth.uid
          && residentAssignmentForRead().caseId
            == resource.data.caseId
          && residentAssignmentForRead().status in [
            'accepted',
            'responding',
            'on_site'
          ]
          && residentCaseForRead().reporterUid
            == resource.data.residentId
          && residentCaseForRead().status in [
            'assigned',
            'in_progress'
          ]
        );
      allow create: if isResident()
        && request.auth.uid == uid
        && validResidentLocationPayload()
        && validResidentLiveMissionForWrite();
      allow update: if isResident()
        && request.auth.uid == uid
        && resource.data.residentId == request.auth.uid
        && validResidentLocationPayload()
        && validResidentLiveMissionForWrite();
      allow delete: if isAdmin()
        || (
          isResident()
          && request.auth.uid == uid
          && resource.data.residentId == request.auth.uid
        );
    }
    // Private human-verified LGU credentials: reference only, never ID scans.
    // Admin access requires a fresh review in the same commit as role promotion.
    match /lguAdminCredentialReviews/{targetUid} {
      function validReview() {
        return isSuperAdmin()
          && request.auth.uid != targetUid
          && request.resource.data.keys().hasOnly([
            'targetUid', 'accountEmail', 'reviewStatus', 'office', 'position',
            'credentialReference', 'verificationMethod', 'verifiedBy', 'verifiedAt'
          ])
          && request.resource.data.targetUid == targetUid
          && request.resource.data.reviewStatus == 'verified'
          && request.resource.data.accountEmail is string
          && request.resource.data.accountEmail.size() >= 5
          && request.resource.data.accountEmail.size() <= 254
          && request.resource.data.office is string
          && request.resource.data.office.size() >= 3
          && request.resource.data.office.size() <= 160
          && request.resource.data.position is string
          && request.resource.data.position.size() >= 3
          && request.resource.data.position.size() <= 120
          && request.resource.data.credentialReference is string
          && request.resource.data.credentialReference.size() >= 5
          && request.resource.data.credentialReference.size() <= 160
          && request.resource.data.verificationMethod is string
          && request.resource.data.verificationMethod.size() >= 8
          && request.resource.data.verificationMethod.size() <= 200
          && request.resource.data.verifiedBy == request.auth.uid
          && request.resource.data.verifiedAt == request.time;
      }
      allow read: if isSuperAdmin();
      allow create, update: if validReview();
      allow delete: if false;
    }
    match /adminLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminOrSuperAdmin();
      allow update, delete: if false;
    }
    match /adminActivityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminOrSuperAdmin();
      allow update, delete: if false;
    }
    match /aiMapBriefings/{briefingId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /aiMapRateLimits/{uid} {
      allow read, write: if false;
    }
    // =========================================================
    // COMMUNITY SERVICE EVENTS
    // Separate from the legacy volunteerEvents emergency/training flow.
    // =========================================================

    // Private opt-in organizer GPS, separate from the public event location.
    // No collection listing, no unjoined Volunteer access, and stale GPS is unreadable.
    match /communityEventLiveLocations/{eventId} {
      function eventPath() {
        return /databases/$(database)/documents/communityEvents/$(eventId);
      }
      function participantPath() {
        let key = eventId + '_' + request.auth.uid;
        return /databases/$(database)/documents/communityEventParticipants/$(key);
      }
      function eventForGps() {
        return get(eventPath()).data;
      }
      function isEventOrganizer() {
        return signedIn()
          && eventForGps().proposedBy == request.auth.uid;
      }
      function isJoinedEventVolunteer() {
        return isVolunteer()
          && exists(participantPath())
          && get(participantPath()).data.uid == request.auth.uid
          && get(participantPath()).data.eventId == eventId
          && get(participantPath()).data.status == 'joined';
      }
      function eventIsOpen() {
        return exists(eventPath())
          && eventForGps().publicationStatus == 'published'
          && eventForGps().status in ['upcoming', 'active'];
      }
      function validLiveCoordinates() {
        return request.resource.data.keys().hasOnly([
          'eventId', 'residentId', 'latitude', 'longitude',
          'accuracyMeters', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.eventId == eventId
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracyMeters is number
        && request.resource.data.accuracyMeters >= 0
        && request.resource.data.accuracyMeters <= 5000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'm');
      }

      // Precise temporary organizer GPS is operational, not programmer oversight.
      allow get: if isAdmin()
        || (
          approved()
          && eventIsOpen()
          && (isEventOrganizer() || isJoinedEventVolunteer())
          && (
            resource == null
            || resource.data.expiresAt > request.time
          )
        );
      allow list: if false;
      allow create: if isResident()
        && eventIsOpen()
        && isEventOrganizer()
        && validLiveCoordinates();
      allow update: if isResident()
        && eventIsOpen()
        && isEventOrganizer()
        && resource.data.residentId == request.auth.uid
        && validLiveCoordinates();
      // A Resident organizer must be able to stop sharing after switching
      // their active account mode to Volunteer. Ownership is still enforced.
      allow delete: if isAdmin()
        || (hasResidentAccess()
          && isEventOrganizer()
          && resource.data.residentId == request.auth.uid);
    }

    match /communityEventProposals/{proposalId} {
      function publishedEventAfter() {
        return getAfter(
          /databases/$(database)/documents/communityEvents/$(proposalId)
        ).data;
      }

      // Resident site photos can be uploaded to an owner-scoped Storage path
      // or provided as HTTPS URLs; Admin must review them before publication.
      function validPhotoUrl(url) {
        return url is string
          && url.size() >= 12
          && url.size() <= 2048
          && url.matches('^https://[^ ]+$');
      }
      function validPhotoUrls(photos) {
        return photos is list
          && photos.size() <= 3
          && (photos.size() < 1 || validPhotoUrl(photos[0]))
          && (photos.size() < 2 || validPhotoUrl(photos[1]))
          && (photos.size() < 3 || validPhotoUrl(photos[2]));
      }
      function validVideoUrl(url) {
        return url is string
          && url.size() <= 2048
          && (
            url == ''
            || url.matches('^https://(www[.]|m[.])?youtube[.]com/.+')
            || url.matches('^https://youtu[.]be/.+')
            || url.matches('^https://(www[.])?vimeo[.]com/.+')
          );
      }

      // Only the proposal owner (or an administrator) may read it.
      // Reading one's own history must not depend on the current UI mode:
      // the app can fall back to Resident mode if Volunteer access is revoked.
      // Writes remain restricted by isResident() below.
      allow get, list: if isAdminOrSuperAdmin()
        || (hasResidentAccess()
          && resource.data.proposedBy == request.auth.uid);

      allow create: if isResident()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'barangay',
          'location', 'date', 'time', 'capacity',
          'proposedBy', 'proposerName', 'status',
          'adminNote', 'createdAt', 'updatedAt',
          'volunteerTasks', 'lookingFor', 'requiredRoles', 'requiredSkills',
          'qualificationNotes', 'whatToBring', 'photoUrls', 'videoUrl',
          'coverPhotoUrl'
        ])
        // New fields remain optional for older Resident clients.
        // Present fields are validated so data cannot bypass review limits.
        && request.resource.data.get('volunteerTasks', '') is string
        && request.resource.data.get('volunteerTasks', '').size() <= 1200
        && (
          !('volunteerTasks' in request.resource.data)
          || request.resource.data.volunteerTasks.size() >= 12
        )
        && request.resource.data.get('lookingFor', '') is string
        && request.resource.data.get('lookingFor', '').size() <= 1600
        && request.resource.data.get('requiredRoles', []) is list
        && request.resource.data.get('requiredRoles', []).size() <= 20
        && (
          !('requiredRoles' in request.resource.data)
          || request.resource.data.requiredRoles.size() >= 1
        )
        && request.resource.data.get('requiredSkills', []) is list
        && request.resource.data.get('requiredSkills', []).size() <= 20
        && request.resource.data.get('qualificationNotes', '') is string
        && request.resource.data.get('qualificationNotes', '').size() <= 500
        && request.resource.data.get('whatToBring', '') is string
        && request.resource.data.get('whatToBring', '').size() <= 500
        && validPhotoUrls(request.resource.data.get('photoUrls', []))
        && validVideoUrl(request.resource.data.get('videoUrl', ''))
        && request.resource.data.get('coverPhotoUrl', '') is string
        && (
          !('coverPhotoUrl' in request.resource.data)
          || (
            validPhotoUrl(request.resource.data.coverPhotoUrl)
            && request.resource.data.get('photoUrls', []).size() >= 1
            && request.resource.data.coverPhotoUrl == request.resource.data.photoUrls[0]
          )
        )
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category in [
          'Clean-up Drive', 'Tree Planting',
          'Feeding Program', 'Pet Welfare',
          'Community Outreach', 'Other'
        ]
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() >= 1
        && request.resource.data.barangay.size() <= 90
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 1
        && request.resource.data.location.size() <= 150
        && request.resource.data.date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.time.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 500
        && request.resource.data.proposerName is string
        && request.resource.data.proposerName.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only the Admin can review a pending proposal.
      // Approval must atomically create a matching published event.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status', 'adminNote', 'publishedEventId',
            'reviewedBy', 'reviewedAt', 'updatedAt'
          ])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() >= 5
        && request.resource.data.adminNote.size() <= 500
        && (
          (
            request.resource.data.status == 'rejected'
            && !('publishedEventId' in request.resource.data)
          )
          ||
          (
            request.resource.data.status == 'approved'
            && request.resource.data.publishedEventId == proposalId
            && publishedEventAfter().sourceProposalId == proposalId
            && publishedEventAfter().approvedBy == request.auth.uid
            && publishedEventAfter().publicationStatus == 'published'
          )
        );

      allow delete: if false;
    }

    match /communityEvents/{eventId} {
      function proposalAfter() {
        return getAfter(
          /databases/$(database)/documents/communityEventProposals/$(eventId)
        ).data;
      }

      function myParticipantPath() {
        let participationId = eventId + '_' + request.auth.uid;
        return /databases/$(database)/documents/communityEventParticipants/$(participationId);
      }

      // Keep approved proposal state loaded once for the entire guarded creation.
      function validApprovedProposalCopy() {
        let proposal = proposalAfter();
        return proposal.status == 'approved'
        && proposal.publishedEventId == eventId
        && proposal.reviewedBy == request.auth.uid
        && proposal.reviewedAt == request.time
        && request.resource.data.title == proposal.title
        && request.resource.data.description == proposal.description
        // Admin can only copy these fields from the approved proposal.
        // Defaults preserve compatibility with proposals made before this update.
        && request.resource.data.volunteerTasks == proposal.get('volunteerTasks', '')
        && request.resource.data.lookingFor == proposal.get('lookingFor', '')
        && request.resource.data.requiredRoles == proposal.get('requiredRoles', [])
        && request.resource.data.requiredSkills == proposal.get('requiredSkills', [])
        && request.resource.data.qualificationNotes == proposal.get('qualificationNotes', '')
        && request.resource.data.whatToBring == proposal.get('whatToBring', '')
        && request.resource.data.photoUrls == proposal.get('photoUrls', [])
        && request.resource.data.videoUrl == proposal.get('videoUrl', '')
        && request.resource.data.coverImageUrl == proposal.get('coverPhotoUrl', '')
        && request.resource.data.category == proposal.category
        && request.resource.data.barangay == proposal.barangay
        && request.resource.data.location == proposal.location
        && request.resource.data.date == proposal.date
        && request.resource.data.time == proposal.time
        && request.resource.data.get('endTime', '') == proposal.get('endTime', '')
        && request.resource.data.get('latitude', null) == proposal.get('latitude', null)
        && request.resource.data.get('longitude', null) == proposal.get('longitude', null)
        && request.resource.data.get('coordinates', null) == proposal.get('coordinates', null)
        && (
          !('endTime' in request.resource.data)
          || (
            request.resource.data.endTime is string
            && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.endTime > request.resource.data.time
          )
        )
        && (
          !('latitude' in request.resource.data)
          || (
            request.resource.data.latitude is number
            && request.resource.data.longitude is number
            && request.resource.data.coordinates is map
            && request.resource.data.coordinates.latitude == request.resource.data.latitude
            && request.resource.data.coordinates.longitude == request.resource.data.longitude
          )
        )
        && request.resource.data.capacity == proposal.capacity
        && request.resource.data.proposedBy == proposal.proposedBy
        && request.resource.data.proposerName == proposal.proposerName;
      }

      // The query on the client filters publicationStatus == published.
      allow get, list: if isAdminOrSuperAdmin()
        || (approved()
          && resource.data.publicationStatus == 'published');

      // Creation requires same-transaction Admin approval of this proposal.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'barangay',
          'location', 'date', 'time', 'endTime', 'capacity',
          'latitude', 'longitude', 'coordinates',
          'participantsCount', 'status', 'publicationStatus',
          'sourceProposalId', 'proposedBy', 'proposerName',
          'approvedBy', 'approvedAt', 'createdAt', 'updatedAt',
          'volunteerTasks', 'lookingFor', 'requiredRoles', 'requiredSkills',
          'qualificationNotes', 'whatToBring', 'photoUrls', 'videoUrl',
          'coverImageUrl'
        ])
        && request.resource.data.sourceProposalId == eventId
        && request.resource.data.status == 'upcoming'
        && request.resource.data.publicationStatus == 'published'
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 500
        && request.resource.data.participantsCount == 0
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validApprovedProposalCopy();

      // Admin can advance status; completion is recorded by the Admin.
      allow update: if isAdmin()
        && resource.data.publicationStatus == 'published'
        && resource.data.status in ['upcoming', 'active']
        && (
          (resource.data.status == 'upcoming'
            && request.resource.data.status in ['active', 'cancelled'])
          ||
          (resource.data.status == 'active'
            && request.resource.data.status in ['completed', 'cancelled'])
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status', 'updatedAt', 'completedAt', 'completedBy'
          ])
        && (
          request.resource.data.status != 'completed'
          || (
            request.resource.data.completedAt == request.time
            && request.resource.data.completedBy == request.auth.uid
          )
        );

      // A Volunteer can increase count only when their matching Join write
      // is part of this same Firestore transaction.
      allow update: if isVolunteer()
        && resource.data.publicationStatus == 'published'
        && resource.data.status in ['upcoming', 'active']
        && resource.data.proposedBy != request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'participantsCount', 'updatedAt'
          ])
        && resource.data.participantsCount is int
        && request.resource.data.participantsCount
          == resource.data.participantsCount + 1
        && request.resource.data.participantsCount
          <= resource.data.capacity
        && request.resource.data.updatedAt == request.time
        && (
          !exists(myParticipantPath())
          || get(myParticipantPath()).data.status == 'declined'
        )
        && getAfter(myParticipantPath()).data.status == 'joined'
        && getAfter(myParticipantPath()).data.uid == request.auth.uid
        && getAfter(myParticipantPath()).data.eventId == eventId
        && getAfter(myParticipantPath()).data.joinedAt == request.time;

      allow delete: if false;
    }

    match /communityEventParticipants/{participantId} {
      function eventBefore() {
        return get(
          /databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)
        ).data;
      }

      function eventAfter() {
        return getAfter(
          /databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)
        ).data;
      }

      // Volunteers may read their OWN participation history even after
      // switching to Resident mode. Revoking Volunteer approval still denies
      // access. Keep the deterministic get and owner-scoped list restrictions.
      // Volunteer writes continue to require the active Volunteer mode below.
      allow get: if isAdminOrSuperAdmin()
        || (hasVolunteerAccess()
          && participantId.matches('^.+_' + request.auth.uid + '$'));
      // Firestore queries must include where("uid", "==", auth.uid).
      allow list: if isAdminOrSuperAdmin()
        || (hasVolunteerAccess() && resource.data.uid == request.auth.uid);

      // The participant's document ID is eventId_uid.
      function validJoinedEventCapacity(event) {
        let later = eventAfter();
        return event.participantsCount is int
          && later.participantsCount == event.participantsCount + 1
          && later.participantsCount <= event.capacity;
      }
      function validParticipantCreation() {
        let event = eventBefore();
        return request.resource.data.eventId is string
        && participantId
          == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && event.publicationStatus == 'published'
        && event.status in ['upcoming', 'active']
        && event.proposedBy != request.auth.uid
        && (
          (
            request.resource.data.status == 'declined'
            && request.resource.data.keys().hasOnly([
              'eventId', 'uid', 'status',
              'declinedAt', 'joinedAt', 'updatedAt'
            ])
            && request.resource.data.declinedAt == request.time
            && request.resource.data.joinedAt == null
          )
          ||
          (
            request.resource.data.status == 'joined'
            && request.resource.data.keys().hasOnly([
              'eventId', 'uid', 'fullName', 'status',
              'joinedAt', 'declinedAt', 'checkedInAt',
              'checkedOutAt', 'attendanceVerified',
              'attendanceVerifiedAt', 'updatedAt'
            ])
            && request.resource.data.fullName is string
            && request.resource.data.fullName.size() <= 120
            && request.resource.data.joinedAt == request.time
            && request.resource.data.declinedAt == null
            && request.resource.data.checkedInAt == null
            && request.resource.data.checkedOutAt == null
            && request.resource.data.attendanceVerified == false
            && request.resource.data.attendanceVerifiedAt == null
            && validJoinedEventCapacity(event)
          )
        );
      }

      allow create: if isVolunteer()
        && validParticipantCreation();

      // All participant updates use one role gate, reducing evaluation cost.
      // Each volunteer transition retains its original field whitelist.
      allow update: if request.auth != null
        // An event participant may never mark their own attendance as verified.
        // Evaluate this denial before the longer Volunteer/Admin checks.
        && !(
          resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAny(['attendanceVerified'])
          && request.resource.data.attendanceVerified == true
        )
        && (
          (
            // A volunteer can only modify their own participant document.
            resource.data.uid == request.auth.uid
            && request.resource.data.get('attendanceVerified', false) == false
            && isVolunteer()
            && (
              (
                // Repeat decline; never change participant status or slots.
                resource.data.status == 'declined'
                && request.resource.data.status == 'declined'
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.eventId == resource.data.eventId
                && participantId == resource.data.eventId + '_' + request.auth.uid
                && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['declinedAt', 'updatedAt'])
                && request.resource.data.declinedAt == request.time
                && request.resource.data.updatedAt == request.time
              )
              ||
              (
                // Declined volunteer joins; event slot count increments atomically.
                resource.data.status == 'declined'
                && request.resource.data.status == 'joined'
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.eventId == resource.data.eventId
                && participantId == resource.data.eventId + '_' + request.auth.uid
                && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'fullName', 'status', 'joinedAt', 'declinedAt',
                    'checkedInAt', 'checkedOutAt', 'attendanceVerified',
                    'attendanceVerifiedAt', 'updatedAt'
                  ])
                && request.resource.data.fullName is string
                && request.resource.data.fullName.size() <= 120
                && request.resource.data.joinedAt == request.time
                && request.resource.data.declinedAt == null
                && request.resource.data.checkedInAt == null
                && request.resource.data.checkedOutAt == null
                && request.resource.data.attendanceVerified == false
                && request.resource.data.attendanceVerifiedAt == null
                && request.resource.data.updatedAt == request.time
                && eventBefore().publicationStatus == 'published'
                && eventBefore().status in ['upcoming', 'active']
                && eventBefore().proposedBy != request.auth.uid
                && eventBefore().participantsCount is int
                && eventAfter().participantsCount == eventBefore().participantsCount + 1
                && eventAfter().participantsCount <= eventBefore().capacity
              )
              ||
              (
                // Volunteer Time In/Out, cannot self-verify.
                resource.data.status == 'joined'
                && resource.data.attendanceVerified == false
                && request.resource.data.attendanceVerified == false
                && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'checkedInAt', 'checkedOutAt', 'updatedAt'
                  ])
                && request.resource.data.updatedAt == request.time
                && eventBefore().status == 'active'
                && (
                  (
                    resource.data.checkedInAt == null
                    && resource.data.checkedOutAt == null
                    && request.resource.data.checkedInAt == request.time
                    && request.resource.data.checkedOutAt == null
                  )
                  ||
                  (
                    resource.data.checkedInAt is timestamp
                    && resource.data.checkedOutAt == null
                    && request.resource.data.checkedInAt == resource.data.checkedInAt
                    && request.resource.data.checkedOutAt == request.time
                  )
                )
              )
            )
          )
          ||
          (
            // LGU Admin-only attendance corrections/verification.
            isAdmin()
            && (
              request.resource.data.attendanceVerified == false
              || request.resource.data.attendanceVerifiedBy == request.auth.uid
            )
            && resource.data.status == 'joined'
            && resource.data.attendanceVerified == false
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'checkedInAt', 'checkedOutAt', 'attendanceVerified',
                'attendanceVerifiedAt', 'attendanceVerifiedBy', 'updatedAt'
              ])
            && (
              (
                request.resource.data.attendanceVerified == false
                && request.resource.data.attendanceVerifiedAt == null
                && !('attendanceVerifiedBy' in request.resource.data)
              )
              ||
              (
                request.resource.data.attendanceVerified == true
                && request.resource.data.checkedInAt is timestamp
                && request.resource.data.checkedOutAt is timestamp
                && request.resource.data.checkedOutAt >= request.resource.data.checkedInAt
                && request.resource.data.attendanceVerifiedAt == request.time
                && request.resource.data.attendanceVerifiedBy == request.auth.uid
              )
            )
          )
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
