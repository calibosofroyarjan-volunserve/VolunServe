        && fieldReportAssignmentAfter().caseId
          == request.resource.data.caseId
        && fieldReportAssignmentAfter().status
          == 'completed'
        && fieldReportCase().reporterUid
          != request.auth.uid;
      allow update: if isAdmin()
        && resource.data.reportStatus in [
          'submitted',
          'reviewed'
        ]
        && request.resource.data.assignmentId
          == resource.data.assignmentId
        && request.resource.data.caseId
          == resource.data.caseId
        && request.resource.data.volunteerId
          == resource.data.volunteerId
        && request.resource.data
