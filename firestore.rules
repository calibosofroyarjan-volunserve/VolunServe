rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // COMMON HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function approved() {
      return signedIn()
        && (
          profile().status == 'approved'
          || (
            !('status' in profile())
            && profile().role != 'applicant'
          )
        );
    }

    function isAdmin() {
      return approved()
        && profile().role in [
          'admin',
          'superadmin'
        ];
    }

    function isSuperAdmin() {
      return approved()
        && profile().role == 'superadmin';
    }

    function isVolunteer() {
      return approved()
        && profile().role == 'volunteer';
    }

    function isResident() {
      return approved()
        && profile().role == 'resident';
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      // Normal applicant registration.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'applicant'
        && request.resource.data.status == 'pending_review'
        && request.resource.data.requestedRole in [
          'resident',
          'volunteer'
        ]
        && request.resource.data.province in [
          'Bulacan',
          'BULACAN',
          'Province of Bulacan'
        ]
        && request.resource.data.city in [
          'City of San Jose del Monte',
          'CITY OF SAN JOSE DEL MONTE',
          'City of San Jose Del Monte',
          'San Jose del Monte',
          'San Jose Del Monte',
          'SAN JOSE DEL MONTE'
        ];

      // Super Admin may create Admin accounts.
      allow create: if isSuperAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'approved'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.reviewedBy == request.auth.uid;

      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow list: if isAdmin();

      // ---------------------------------------------------------
      // OWN PROFILE EDITING
      // ---------------------------------------------------------

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'fullName',
            'lastName',
            'firstName',
            'middleName',
            'age',
            'phoneNumber',
            'region',
            'province',
            'city',
            'barangay',
            'address',
            'occupationCategory',
            'occupationSpecialization',
            'occupationOther',
            'occupation',
            'skills',
            'skillOther',
            'availability',
            'profilePictureUrl'
          ])

        && (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'province'
            ])
          || request.resource.data.province in [
            'Bulacan',
            'BULACAN',
            'Province of Bulacan'
          ]
        )

        && (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'city'
            ])
          || request.resource.data.city in [
            'City of San Jose del Monte',
            'CITY OF SAN JOSE DEL MONTE',
            'City of San Jose Del Monte',
            'San Jose del Monte',
            'San Jose Del Monte',
            'SAN JOSE DEL MONTE'
          ]
        );

      // Super Admin has full management access.
      allow update: if isSuperAdmin();

      // Admin approval / role management.
      allow update: if isAdmin()
        && resource.data.role != 'superadmin'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'role',
            'requestedRole',
            'primaryRole',
            'residentAccess',
            'volunteerAccess',
            'volunteerStatus',
            'activeMode',
            'status',
            'reviewedAt',
            'reviewedBy',
            'rejectedReason',
            'volunteerReviewedAt',
            'volunteerReviewedBy'
          ])

        && request.resource.data.role in [
          'applicant',
          'resident',
          'volunteer'
        ]

        && request.resource.data.status in [
          'pending_review',
          'approved',
          'rejected',
          'suspended'
        ]

        && (
          !('activeMode' in request.resource.data)
          || request.resource.data.activeMode in [
            'resident',
            'volunteer'
          ]
        )

        && (
          !('primaryRole' in request.resource.data)
          || request.resource.data.primaryRole in [
            'resident',
            'volunteer'
          ]
        )

        && (
          !('residentAccess' in request.resource.data)
          || request.resource.data.residentAccess is bool
        )

        && (
          !('volunteerAccess' in request.resource.data)
          || request.resource.data.volunteerAccess is bool
        )

        && (
          !('volunteerStatus' in request.resource.data)
          || request.resource.data.volunteerStatus in [
            'not_applied',
            'pending',
            'approved',
            'rejected'
          ]
        )

        && (
          !('volunteerAccess' in request.resource.data)
          || request.resource.data.volunteerAccess == false
          || (
            'volunteerStatus' in request.resource.data
            && request.resource.data.volunteerStatus == 'approved'
          )
        )

        && (
          !('activeMode' in request.resource.data)
          || request.resource.data.activeMode == 'resident'
          || request.resource.data.role == 'volunteer'
          || (
            'volunteerAccess' in request.resource.data
            && request.resource.data.volunteerAccess == true
          )
        );

      allow delete: if isSuperAdmin()
        && request.auth.uid != uid;
    }

    // =========================================================
    // ADDRESS DATA
    // =========================================================

    match /address_regions/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // SYSTEM SETTINGS
    // =========================================================

    match /systemSettings/{settingId} {

      allow read: if settingId == 'public';

      allow create, update: if isSuperAdmin()
        && settingId == 'public'
        && request.resource.data.keys().hasOnly([
          'cityName',
          'emergencyHotline',
          'supportEmail',
          'publicServiceNotice',
          'liveLocationRetentionHours',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.cityName is string
        && request.resource.data.cityName.size() >= 3
        && request.resource.data.cityName.size() <= 120
        && request.resource.data.emergencyHotline is string
        && request.resource.data.emergencyHotline.size() >= 3
        && request.resource.data.emergencyHotline.size() <= 160
        && request.resource.data.supportEmail is string
        && request.resource.data.supportEmail.size() <= 160
        && request.resource.data.publicServiceNotice is string
        && request.resource.data.publicServiceNotice.size() >= 10
        && request.resource.data.publicServiceNotice.size() <= 500
        && request.resource.data.liveLocationRetentionHours is int
        && request.resource.data.liveLocationRetentionHours >= 1
        && request.resource.data.liveLocationRetentionHours <= 720
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // =========================================================
    // ANNOUNCEMENTS
    // =========================================================

    match /announcements/{announcementId} {

      // Published announcements are readable by approved users.
      // The client feed displays only:
      //   - global announcements (audience == 'all')
      //   - announcements for the user's own barangay.
      // Admin / Super Admin may also read announcement records.
      allow read: if isAdmin()
        || (
          approved()
          && resource.data.publishAt is timestamp
          && resource.data.publishAt <= request.time
        );

      // ---------------------------------------------------------
      // CREATE ANNOUNCEMENT
      //
      // Super Admin -> global only
      // Admin       -> own barangay only
      // ---------------------------------------------------------
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'message',
          'linkUrl',
          'imageUrl',
          'audience',
          'priority',
          'publishAt',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.linkUrl is string
        && request.resource.data.imageUrl is string
        && request.resource.data.priority in [
          'normal',
          'urgent'
        ]
        && request.resource.data.publishAt is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && (
          (
            isSuperAdmin()
            && request.resource.data.audience == 'all'
          )
          || (
            approved()
            && profile().role == 'admin'
            && profile().barangay is string
            && profile().barangay.size() > 0
            && request.resource.data.audience == profile().barangay
          )
        );

      // Super Admin may update any announcement.
      // Admin may update only announcements for their own barangay
      // and may not change that announcement into another audience.
      allow update: if isSuperAdmin()
        || (
          approved()
          && profile().role == 'admin'
          && profile().barangay is string
          && resource.data.audience == profile().barangay
          && request.resource.data.audience == resource.data.audience
          && request.resource.data.createdBy == resource.data.createdBy
        );

      // Super Admin may delete any announcement.
      // Admin may delete only announcements for their own barangay.
      allow delete: if isSuperAdmin()
        || (
          approved()
          && profile().role == 'admin'
          && profile().barangay is string
          && resource.data.audience == profile().barangay
        );
    }

    // =========================================================
    // VOLUNTEER APPLICATIONS
    // =========================================================

    match /volunteerApplications/{uid} {

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // LEGACY / GENERAL ASSISTANCE REQUESTS
    // =========================================================

    match /assistanceRequests/{requestId} {

      function validAssistanceStatusTransition() {
        return request.resource.data.status == resource.data.status

          || (
            resource.data.status == 'submitted'
            && request.resource.data.status in [
              'reviewed',
              'rejected'
            ]
          )

          || (
            resource.data.status == 'reviewed'
            && request.resource.data.status in [
              'approved',
              'rejected'
            ]
          )

          || (
            resource.data.status == 'approved'
            && request.resource.data.status in [
              'assigned',
              'delivered'
            ]
          )

          || (
            resource.data.status == 'assigned'
            && request.resource.data.status in [
              'in_progress',
              'delivered'
            ]
          )

          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'delivered'
          )

          || (
            resource.data.status == 'delivered'
            && request.resource.data.status == 'closed'
          );
      }

      allow create: if isResident()
        && request.resource.data.keys().hasOnly([
          'requestId',
          'requesterUid',
          'requesterName',
          'requesterEmail',
          'requesterBarangay',
          'contactNumber',
          'beneficiaryType',
          'assistanceType',
          'urgency',
          'description',
          'location',
          'latitude',
          'longitude',
          'gpsAccuracyMeters',
          'locationCapturedAt',
          'status',
          'linkedCaseId',
          'assignedVolunteerId',
          'assignedVolunteerName',
          'adminNote',
          'reviewedAt',
          'assignedAt',
          'deliveredAt',
          'closedAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.requestId == requestId
        && request.resource.data.requesterUid == request.auth.uid

        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() >= 1
        && request.resource.data.requesterName.size() <= 120

        && request.resource.data.requesterEmail is string
        && request.resource.data.requesterEmail.size() <= 160

        && request.resource.data.requesterBarangay is string
        && request.resource.data.requesterBarangay.size() <= 120

        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() >= 8
        && request.resource.data.contactNumber.size() <= 30

        && request.resource.data.beneficiaryType in [
          'self',
          'someone_else'
        ]

        && request.resource.data.assistanceType in [
          'food',
          'water',
          'medical',
          'shelter',
          'evacuation',
          'transportation',
          'other'
        ]

        && request.resource.data.urgency in [
          'normal',
          'urgent',
          'critical'
        ]

        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 600

        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 180

        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90

        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180

        && request.resource.data.gpsAccuracyMeters is number
        && request.resource.data.gpsAccuracyMeters >= 0
        && request.resource.data.gpsAccuracyMeters <= 10000

        && request.resource.data.locationCapturedAt is timestamp

        && request.resource.data.status == 'submitted'

        && request.resource.data.linkedCaseId == ''
        && request.resource.data.assignedVolunteerId == ''
        && request.resource.data.assignedVolunteerName == ''
        && request.resource.data.adminNote == ''

        && request.resource.data.reviewedAt == null
        && request.resource.data.assignedAt == null
        && request.resource.data.deliveredAt == null
        && request.resource.data.closedAt == null

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isAdmin()

        || (
          isResident()
          && resource.data.requesterUid == request.auth.uid
        )

        || (
          isVolunteer()
          && resource.data.assignedVolunteerId == request.auth.uid
        );

      allow update: if isAdmin()
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requesterUid == resource.data.requesterUid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'linkedCaseId',
            'assignedVolunteerId',
            'assignedVolunteerName',
            'adminNote',
            'reviewedAt',
            'assignedAt',
            'deliveredAt',
            'closedAt',
            'updatedAt'
          ])

        && validAssistanceStatusTransition();

      allow update: if isVolunteer()
        && resource.data.assignedVolunteerId == request.auth.uid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requesterUid == resource.data.requesterUid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'deliveredAt',
            'updatedAt'
          ])

        && (
          (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'in_progress'
          )

          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'delivered'
          )
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // CANONICAL EMERGENCY / DISASTER CASES
    // =========================================================

    match /disasterCases/{caseId} {

      function validStatusTransition() {
        return request.resource.data.status == resource.data.status

          || (
            resource.data.status == 'reported'
            && request.resource.data.status == 'validated'
          )

          || (
            resource.data.status == 'validated'
            && request.resource.data.status == 'assigned'
          )

          || (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'in_progress'
          )

          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'resolved'
          )

          || (
            resource.data.status == 'resolved'
            && request.resource.data.status == 'closed'
          );
      }

      // Canonical detailed Emergency Report.
      // No beneficiaryType field here.
      allow create: if isResident()

        && request.resource.data.keys().hasOnly([
          'reporterUid',
          'reporterName',
          'reporterEmail',
          'reporterBarangay',
          'reporterAddress',
          'contactNumber',
          'emergencyContact',
          'reporterProfilePictureUrl',

          'source',
          'requestKind',

          'title',
          'category',
          'severity',
          'status',

          'verificationStatus',
          'evidenceReviewStatus',

          'location',
          'latitude',
          'longitude',
          'gpsAccuracyMeters',
          'locationCapturedAt',

          'details',
          'affectedPeople',

          'assistanceTypes',
          'requiredSkills',
          'neededGoods',
          'needsNote',
          'needs',

          'attachments',
          'photoEvidenceCount',
          'videoEvidenceCount',

          'verification',

          'residentConfirmationAccepted',
          'residentConfirmationAt',
          'privacyScope',

          'requiredVolunteers',
          'assignedVolunteersCount',
          'assignedVolunteerIds',

          'adminNote',

          'validatedAt',
          'validatedBy',
          'assignedAt',
          'resolvedAt',
          'closedAt',

          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.reporterUid == request.auth.uid

        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() >= 1
        && request.resource.data.reporterName.size() <= 120

        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() <= 160

        && request.resource.data.reporterBarangay is string
        && request.resource.data.reporterBarangay.size() <= 120

        && request.resource.data.reporterAddress is string
        && request.resource.data.reporterAddress.size() <= 240

        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() >= 8
        && request.resource.data.contactNumber.size() <= 30

        && request.resource.data.emergencyContact is string
        && request.resource.data.emergencyContact.size() <= 30

        && request.resource.data.reporterProfilePictureUrl is string
        && request.resource.data.reporterProfilePictureUrl.size() <= 2048

        && request.resource.data.source
          == 'resident_emergency_assistance'

        && request.resource.data.requestKind
          == 'emergency_assistance'

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120

        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 80

        && request.resource.data.severity in [
          'low',
          'medium',
          'high',
          'critical'
        ]

        && request.resource.data.status == 'reported'

        && request.resource.data.verificationStatus
          == 'pending_verification'

        && request.resource.data.evidenceReviewStatus
          == 'pending_review'

        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 240

        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90

        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180

        && (
          request.resource.data.gpsAccuracyMeters == null
          || request.resource.data.gpsAccuracyMeters is number
        )

        && request.resource.data.locationCapturedAt is timestamp

        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 2000

        && request.resource.data.affectedPeople is int
        && request.resource.data.affectedPeople >= 1

        && request.resource.data.assistanceTypes is list
        && request.resource.data.assistanceTypes.size() >= 1
        && request.resource.data.assistanceTypes.size() <= 12

        && request.resource.data.requiredSkills is list
        && request.resource.data.requiredSkills.size() >= 1
        && request.resource.data.requiredSkills.size() <= 12

        && request.resource.data.neededGoods is list
        && request.resource.data.neededGoods.size() >= 1
        && request.resource.data.neededGoods.size() <= 12

        && request.resource.data.needsNote is string
        && request.resource.data.needsNote.size() <= 1500

        && request.resource.data.needs is string
        && request.resource.data.needs.size() >= 2
        && request.resource.data.needs.size() <= 2500

        // 5 photos + optional single video.
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() >= 1
        && request.resource.data.attachments.size() <= 6

        && request.resource.data.photoEvidenceCount is int
        && request.resource.data.photoEvidenceCount >= 1
        && request.resource.data.photoEvidenceCount <= 5

        && request.resource.data.videoEvidenceCount is int
        && request.resource.data.videoEvidenceCount >= 0
        && request.resource.data.videoEvidenceCount <= 1

        && request.resource.data.verification is map

        && request.resource.data.residentConfirmationAccepted == true
        && request.resource.data.residentConfirmationAt is timestamp

        && request.resource.data.privacyScope
          == 'admin_and_assigned_responder'

        && request.resource.data.requiredVolunteers == 0
        && request.resource.data.assignedVolunteersCount == 0

        && request.resource.data.assignedVolunteerIds is list
        && request.resource.data.assignedVolunteerIds.size() == 0

        && request.resource.data.adminNote == ''

        && request.resource.data.validatedAt == null
        && request.resource.data.validatedBy == null
        && request.resource.data.assignedAt == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.closedAt == null

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isAdmin()

        || (
          isResident()
          && resource.data.reporterUid == request.auth.uid
        )

        || (
          isVolunteer()
          && resource.data.assignedVolunteerIds is list
          && request.auth.uid in resource.data.assignedVolunteerIds
          && resource.data.status in [
            'assigned',
            'in_progress',
            'resolved'
          ]
        );

      // Allows status transitions and verification/evidence changes
      // while preserving normal Admin operational control.
      allow update: if isAdmin()
        && validStatusTransition();

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // PUBLIC INCIDENT MAP DATA
    // =========================================================

    match /publicIncidentSummaries/{caseId} {

      allow read: if true;

      allow create, update: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'caseId',
          'title',
          'category',
          'severity',
          'status',
          'location',
          'latitude',
          'longitude',
          'requiredVolunteers',
          'assignedVolunteersCount',
          'createdAt',
          'updatedAt',
          'publishedAt'
        ])

        && request.resource.data.caseId == caseId

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120

        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 80

        && request.resource.data.severity in [
          'low',
          'medium',
          'high',
          'critical'
        ]

        && request.resource.data.status in [
          'validated',
          'assigned',
          'in_progress',
          'resolved'
        ]

        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3

        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90

        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180

        && request.resource.data.requiredVolunteers is int
        && request.resource.data.requiredVolunteers >= 0

        && request.resource.data.assignedVolunteersCount is int
        && request.resource.data.assignedVolunteersCount >= 0

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.publishedAt is timestamp;

      allow delete: if isAdmin();
    }

    // =========================================================
    // VOLUNTEER EVENTS / ATTENDANCE
    // =========================================================

    match /volunteerEvents/{eventId} {

      allow read: if approved();

      allow create, update, delete: if isAdmin();

      match /participants/{uid} {

        allow read: if approved();

        allow create: if isAdmin()
          || (
            isVolunteer()
            && request.auth.uid == uid
            && request.resource.data.uid == uid
          );

        allow update: if isAdmin();

        allow update: if isVolunteer()
          && request.auth.uid == uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'checkedInAt',
              'checkedOutAt',
              'attendanceStatus',
              'updatedAt'
            ]);

        allow delete: if isAdmin()
          || (
            isVolunteer()
            && request.auth.uid == uid
          );
      }
    }

    // =========================================================
    // CASE INVITATIONS
    // =========================================================

    match /caseInvitations/{invitationId} {

      allow create, delete: if isAdmin();

      allow read: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        );

      allow update: if isAdmin()

        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'respondedAt'
            ])
        );
    }

    // =========================================================
    // DONATIONS
    // =========================================================

    match /donations/{donationId} {

      function validDonationVerification() {
        return resource.data.status == 'pending'

          && request.resource.data.status == 'received'

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'verificationCode',
              'verifiedBy',
              'verifiedAt',
              'updatedAt'
            ])

          && request.resource.data.verificationCode is string
          && request.resource.data.verificationCode.size() >= 12
          && request.resource.data.verificationCode.size() <= 26

          && request.resource.data.verifiedBy == request.auth.uid

          && request.resource.data.verifiedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      function validDonationRejection() {
        return resource.data.status == 'pending'

          && request.resource.data.status == 'rejected'

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'rejectedBy',
              'rejectedAt',
              'rejectionReason',
              'updatedAt'
            ])

          && request.resource.data.rejectedBy == request.auth.uid

          && request.resource.data.rejectedAt is timestamp

          && request.resource.data.rejectionReason is string
          && request.resource.data.rejectionReason.size() >= 10
          && request.resource.data.rejectionReason.size() <= 500

          && request.resource.data.updatedAt is timestamp;
      }

      function validDonationDistribution() {
        return resource.data.status == 'received'

          && request.resource.data.status == 'distributed'

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'beneficiary',
              'familiesHelped',
              'distributionNote',
              'distributedBy',
              'distributedAt',
              'updatedAt'
            ])

          && request.resource.data.beneficiary is string
          && request.resource.data.beneficiary.size() >= 3
          && request.resource.data.beneficiary.size() <= 200

          && request.resource.data.familiesHelped is int
          && request.resource.data.familiesHelped > 0

          && request.resource.data.distributionNote is string
          && request.resource.data.distributionNote.size() <= 1000

          && request.resource.data.distributedBy == request.auth.uid

          && request.resource.data.distributedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      allow create: if false;

      allow read: if isAdmin()

        || (
          approved()
          && resource.data.donorUid == request.auth.uid
        );

      allow update: if isAdmin()
        && (
          validDonationVerification()
          || validDonationRejection()
          || validDonationDistribution()
        );

      allow delete: if false;

      match /logs/{logId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // =========================================================
    // PUBLIC DONATION VERIFICATION
    // =========================================================

    match /publicDonationVerifications/{donationId} {

      allow read: if true;

      allow create: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'verificationCode',
          'officialReference',
          'receivingOffice',
          'donationType',
          'amount',
          'itemsDescription',
          'status',
          'verifiedAt',
          'distributedAt'
        ])

        && request.resource.data.verificationCode is string
        && request.resource.data.officialReference is string
        && request.resource.data.receivingOffice is string

        && request.resource.data.donationType in [
          'monetary',
          'in_kind'
        ]

        && request.resource.data.amount is number
        && request.resource.data.itemsDescription is string

        && request.resource.data.status in [
          'received',
          'distributed'
        ]

        && request.resource.data.verifiedAt is timestamp

        && (
          request.resource.data.status == 'received'

          || (
            request.resource.data.keys().hasAll([
              'distributedAt'
            ])
            && request.resource.data.distributedAt is timestamp
          )
        );

      allow update: if isAdmin()
        && resource.data.status == 'received'
        && request.resource.data.status == 'distributed'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'distributedAt'
          ])

        && request.resource.data.distributedAt is timestamp;

      allow delete: if false;
    }

    match /publicDonationDistributions/{donationId} {

      allow read: if true;

      allow create: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'donationType',
          'amount',
          'itemsDescription',
          'barangay',
          'beneficiary',
          'familiesHelped',
          'distributedAt'
        ])

        && request.resource.data.donationType in [
          'monetary',
          'in_kind'
        ]

        && request.resource.data.amount is number
        && request.resource.data.itemsDescription is string
        && request.resource.data.barangay is string
        && request.resource.data.beneficiary is string

        && request.resource.data.familiesHelped is int
        && request.resource.data.familiesHelped > 0

        && request.resource.data.distributedAt is timestamp;

      allow update, delete: if false;
    }

    // =========================================================
    // VOLUNTEER SERVICE CERTIFICATES
    // =========================================================

    match /certificates/{certificateId} {

      allow read: if isAdmin()

        || (
          approved()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.volunteerId == request.auth.uid
          )
        );

      // Spark/demo architecture.
      // Admin is the issuance trust boundary.
      allow create: if isAdmin()

        && request.resource.data.certificateId == certificateId

        && request.resource.data.certificateType
          == 'verified_volunteer_service'

        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0

        && request.resource.data.volunteerId
          == request.resource.data.userId

        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 120

        && request.resource.data.verificationStatus == 'issued'

        && request.resource.data.verifiedHelps is int
        && request.resource.data.verifiedHelps >= 1

        && request.resource.data.verifiedServiceMinutes is int
        && request.resource.data.verifiedServiceMinutes >= 0

        && request.resource.data.peopleHelped is int
        && request.resource.data.peopleHelped >= 0

        && request.resource.data.contributionIds is list
        && request.resource.data.contributionIds.size() >= 1

        && request.resource.data.snapshotHash is string
        && request.resource.data.snapshotHash.size() > 0

        && request.resource.data.issuedAt is timestamp
        && request.resource.data.createdAt is timestamp;

      // Certificate revocation.
      allow update: if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'revocationReason',
            'revokedAt',
            'revokedBy',
            'revokedByName',
            'updatedAt'
          ])

        && resource.data.verificationStatus == 'issued'

        && request.resource.data.verificationStatus == 'revoked'

        && request.resource.data.revocationReason is string
        && request.resource.data.revocationReason.size() >= 10
        && request.resource.data.revocationReason.size() <= 500

        && request.resource.data.revokedBy == request.auth.uid

        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // =========================================================
    // PUBLIC CERTIFICATE VERIFICATION
    // =========================================================

    match /publicCertificateVerifications/{certificateId} {

      // Public can retrieve ONE exact certificate document.
      allow get: if true;

      // Prevent enumeration of every certificate.
      allow list: if false;

      allow create: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'certificateId',
          'certificateType',
          'certificateTitle',

          'volunteerName',

          'verifiedHelps',
          'fullVerifiedHelps',
          'partialVerifiedHelps',
          'verifiedEmergencyResponses',
          'verifiedServiceMinutes',
          'peopleHelped',

          'contributionBreakdown',
          'contributionCount',

          'snapshotHash',

          'verificationStatus',

          'issuedByName',
          'issuedByRole',
          'issuerOrganization',

          'issuedAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.keys().hasAll([
          'certificateId',
          'certificateType',
          'volunteerName',
          'verifiedHelps',
          'verifiedServiceMinutes',
          'peopleHelped',
          'contributionBreakdown',
          'snapshotHash',
          'verificationStatus',
          'issuedAt',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.certificateId == certificateId

        && request.resource.data.certificateType
          == 'verified_volunteer_service'

        && (
          !('certificateTitle' in request.resource.data)
          || request.resource.data.certificateTitle is string
        )

        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() >= 1
        && request.resource.data.volunteerName.size() <= 120

        && request.resource.data.verificationStatus == 'issued'

        && request.resource.data.verifiedHelps is int
        && request.resource.data.verifiedHelps >= 1

        && (
          !('fullVerifiedHelps' in request.resource.data)
          || (
            request.resource.data.fullVerifiedHelps is int
            && request.resource.data.fullVerifiedHelps >= 0
          )
        )

        && (
          !('partialVerifiedHelps' in request.resource.data)
          || (
            request.resource.data.partialVerifiedHelps is int
            && request.resource.data.partialVerifiedHelps >= 0
          )
        )

        && (
          !('verifiedEmergencyResponses' in request.resource.data)
          || (
            request.resource.data.verifiedEmergencyResponses is int
            && request.resource.data.verifiedEmergencyResponses >= 0
          )
        )

        && request.resource.data.verifiedServiceMinutes is int
        && request.resource.data.verifiedServiceMinutes >= 0

        && request.resource.data.peopleHelped is int
        && request.resource.data.peopleHelped >= 0

        && request.resource.data.contributionBreakdown is list

        && (
          !('contributionCount' in request.resource.data)
          || (
            request.resource.data.contributionCount is int
            && request.resource.data.contributionCount >= 1
          )
        )

        && request.resource.data.snapshotHash is string
        && request.resource.data.snapshotHash.size() > 0

        && (
          !('issuedByName' in request.resource.data)
          || request.resource.data.issuedByName is string
        )

        && (
          !('issuedByRole' in request.resource.data)
          || request.resource.data.issuedByRole is string
        )

        && (
          !('issuerOrganization' in request.resource.data)
          || request.resource.data.issuerOrganization is string
        )

        && request.resource.data.issuedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'revocationReason',
            'revokedAt',
            'revokedByName',
            'updatedAt'
          ])

        && resource.data.verificationStatus == 'issued'

        && request.resource.data.verificationStatus == 'revoked'

        && request.resource.data.revocationReason is string
        && request.resource.data.revocationReason.size() >= 10
        && request.resource.data.revocationReason.size() <= 500

        && request.resource.data.revokedByName is string

        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // =========================================================
    // VOLUNTEER STATS
    // =========================================================

    match /volunteerStats/{uid} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // =========================================================
    // VERIFIED CONTRIBUTIONS
    //
    // Spark/free demo architecture:
    // Resident Full/Partial confirmation and this record are
    // written together atomically using writeBatch().
    // =========================================================

    match /verifiedContributions/{assignmentId} {

      function contributionAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }

      function contributionCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      function contributionConfirmation() {
        return getAfter(
          /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
        ).data;
      }

      allow read: if isAdmin()

        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        )

        || (
          approved()
          && resource.data.residentId == request.auth.uid
        );

      allow create: if isResident()

        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',

          'volunteerId',
          'volunteerName',

          'residentId',
          'outcome',

          'contributionType',
          'contributionSummary',
          'peopleHelped',
          'completionNotes',

          'responseStartedAt',
          'arrivedAt',
          'completedAt',

          'residentConfirmedAt',

          'verificationSource',
          'status',

          'createdAt',
          'verifiedAt'
        ])

        && request.resource.data.assignmentId == assignmentId

        && request.resource.data.residentId == request.auth.uid

        && request.resource.data.outcome in [
          'fully_helped',
          'partially_helped'
        ]

        && request.resource.data.status == 'verified'

        && request.resource.data.verificationSource
          == 'resident_confirmation'

        && request.resource.data.caseId
          == contributionAssignment().caseId

        && request.resource.data.volunteerId
          == contributionAssignment().volunteerId

        // Self-response can never become verified contribution credit.
        && request.resource.data.volunteerId
          != request.auth.uid

        && request.resource.data.volunteerName
          == contributionAssignment().volunteerName

        && contributionAssignment().status == 'completed'

        && contributionCase().reporterUid == request.auth.uid

        && request.resource.data.contributionType
          == contributionAssignment().contributionType

        && request.resource.data.contributionSummary
          == contributionAssignment().contributionSummary

        && request.resource.data.peopleHelped
          == contributionAssignment().peopleHelped

        && request.resource.data.completionNotes
          == contributionAssignment().completionNotes

        && request.resource.data.responseStartedAt
          == contributionAssignment().responseStartedAt

        && request.resource.data.arrivedAt
          == contributionAssignment().arrivedAt

        && request.resource.data.completedAt
          == contributionAssignment().completedAt

        && contributionConfirmation().assignmentId == assignmentId

        && contributionConfirmation().residentId
          == request.auth.uid

        && contributionConfirmation().volunteerId
          == request.resource.data.volunteerId

        && contributionConfirmation().outcome
          == request.resource.data.outcome

        && contributionConfirmation().reviewState
          == 'resident_confirmed'

        && contributionConfirmation().creditStatus
          == 'credited'

        && request.resource.data.residentConfirmedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.verifiedAt is timestamp;

      allow update, delete: if false;
    }

    // =========================================================
    // RESPONSE DISPUTES
    //
    // Not Helped does NOT grant volunteer contribution credit.
    // It becomes an Admin-review dispute instead.
    // =========================================================

    match /responseDisputes/{assignmentId} {

      function disputeAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }

      function disputeCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      function disputeConfirmation() {
        return getAfter(
          /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
        ).data;
      }

      allow read: if isAdmin()

        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        )

        || (
          approved()
          && resource.data.residentId == request.auth.uid
        );

      allow create: if isResident()

        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',
          'volunteerId',
          'residentId',
          'residentNote',
          'contributionType',
          'contributionSummary',
          'status',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.assignmentId == assignmentId

        && request.resource.data.residentId == request.auth.uid

        && request.resource.data.status == 'open'

        && request.resource.data.residentNote is string
        && request.resource.data.residentNote.size() >= 10
        && request.resource.data.residentNote.size() <= 1000

        && disputeAssignment().status == 'completed'

        && disputeAssignment().caseId
          == request.resource.data.caseId

        && disputeAssignment().volunteerId
          == request.resource.data.volunteerId

        // Reporter and responder must be different accounts.
        && request.resource.data.volunteerId
          != request.auth.uid

        && request.resource.data.contributionType
          == disputeAssignment().contributionType

        && request.resource.data.contributionSummary
          == disputeAssignment().contributionSummary

        && disputeCase().reporterUid == request.auth.uid

        && disputeConfirmation().assignmentId == assignmentId

        && disputeConfirmation().outcome == 'not_helped'

        && disputeConfirmation().reviewState == 'disputed'

        && disputeConfirmation().creditStatus == 'disputed'

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Future Admin dispute resolution.
      allow update: if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'adminNote',
            'resolvedAt',
            'resolvedBy',
            'updatedAt'
          ])

        && request.resource.data.status in [
          'open',
          'resolved',
          'dismissed'
        ]

        && (
          !('adminNote' in request.resource.data)
          || request.resource.data.adminNote is string
        )

        && (
          !('resolvedAt' in request.resource.data)
          || request.resource.data.resolvedAt is timestamp
        )

        && (
          !('resolvedBy' in request.resource.data)
          || request.resource.data.resolvedBy == request.auth.uid
        )

        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // =========================================================
    // RESPONSE AUDIT LOGS
    // =========================================================

    match /responseAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      function responderNotificationAssignment() {
        return getAfter(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }

      function responderNotificationCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      // Admin may create ordinary system notifications.
      allow create: if isAdmin();

      // Assigned volunteer may notify the case owner about
      // their response lifecycle.
      allow create: if isVolunteer()

        && request.resource.data.keys().hasOnly([
          'userId',
          'caseId',
          'assignmentId',
          'responderId',
          'responderName',
          'title',
          'message',
          'type',
          'status',
          'read',
          'createdAt'
        ])

        && request.resource.data.userId is string
        && request.resource.data.caseId is string
        && request.resource.data.assignmentId is string

        && request.resource.data.responderId == request.auth.uid

        && request.resource.data.responderName is string
        && request.resource.data.responderName.size() >= 1
        && request.resource.data.responderName.size() <= 120

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 160

        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000

        && request.resource.data.type == 'resident_response_update'

        && request.resource.data.status in [
          'accepted',
          'responding',
          'on_site',
          'completed'
        ]

        && request.resource.data.read == false

        && request.resource.data.createdAt is timestamp

        && responderNotificationAssignment().volunteerId
          == request.auth.uid

        && responderNotificationAssignment().caseId
          == request.resource.data.caseId

        && responderNotificationAssignment().status
          == request.resource.data.status

        && responderNotificationCase().reporterUid
          == request.resource.data.userId

        // A responder can never notify themselves as the case reporter.
        && request.resource.data.userId
          != request.auth.uid;

      allow read, update: if approved()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );

      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // SUPPORT TICKETS
    // =========================================================

    match /tickets/{ticketId} {

      allow create: if approved()

        && request.resource.data.keys().hasOnly([
          'submitterId',
          'submitterName',
          'submitterEmail',
          'submitterRole',
          'category',
          'subject',
          'description',
          'status',
          'priority',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.submitterId == request.auth.uid

        && request.resource.data.submitterRole == profile().role

        && request.resource.data.category in [
          'system',
          'task',
          'donation',
          'emergency',
          'other'
        ]

        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 120

        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500

        && request.resource.data.status == 'open'
        && request.resource.data.priority == 'normal';

      allow read: if isAdmin()

        || (
          approved()
          && resource.data.submitterId == request.auth.uid
        );

      allow update: if isAdmin();

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // EVACUATION CENTERS
    // =========================================================

    match /evacuation_centers/{centerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // LEGACY USER LIVE LOCATION
    // =========================================================

    match /users_live_locations/{uid} {

      allow read: if isAdmin()

        || (
          isVolunteer()
          && request.auth.uid == uid
        );

      allow create, update, delete: if approved()
        && request.auth.uid == uid;
    }

    match /volunteers_live_locations/{uid} {

      allow read: if isAdmin()
        || isVolunteer();

      allow create, update, delete: if isVolunteer()
        && request.auth.uid == uid;
    }

    // =========================================================
    // CASE CHAT
    //
    // Resident <-> assigned Volunteer <-> Admin
    // =========================================================

    match /caseMessages/{caseId}/messages/{messageId} {

      function chatCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(caseId)
        ).data;
      }

      function existingChatAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(resource.data.assignmentId)
        ).data;
      }

      function incomingChatAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }

      function validReadableChatAssignment() {
        return resource.data.caseId == caseId

          && existingChatAssignment().caseId == caseId

          && existingChatAssignment().status in [
            'accepted',
            'responding',
            'on_site',
            'completed'
          ];
      }

      function validIncomingChatAssignment() {
        return request.resource.data.caseId == caseId

          && incomingChatAssignment().caseId == caseId

          && incomingChatAssignment().status in [
            'accepted',
            'responding',
            'on_site',
            'completed'
          ];
      }

      allow read: if isAdmin()

        || (
          isResident()
          && chatCase().reporterUid == request.auth.uid
          && validReadableChatAssignment()
        )

        || (
          isVolunteer()
          && existingChatAssignment().volunteerId == request.auth.uid
          && validReadableChatAssignment()
        );

      allow create: if approved()

        && request.resource.data.keys().hasOnly([
          'caseId',
          'assignmentId',
          'senderUid',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ])

        && request.resource.data.caseId == caseId

        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0

        && request.resource.data.senderUid == request.auth.uid

        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 120

        && request.resource.data.senderRole in [
          'resident',
          'volunteer',
          'admin'
        ]

        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000

        && request.resource.data.createdAt is timestamp

        && chatCase().status in [
          'assigned',
          'in_progress'
        ]

        && validIncomingChatAssignment()

        && (
          (
            isAdmin()
            && request.resource.data.senderRole == 'admin'
          )

          || (
            isResident()
            && chatCase().reporterUid == request.auth.uid
            && request.resource.data.senderRole == 'resident'
          )

          || (
            isVolunteer()
            && incomingChatAssignment().volunteerId == request.auth.uid
            && chatCase().reporterUid != request.auth.uid
            && request.resource.data.senderRole == 'volunteer'
          )
        );

      allow update, delete: if false;
    }

    // =========================================================
    // RESPONSE ASSIGNMENTS
    //
    // Admin offers
    // Volunteer accepts/responds/arrives/completes
    // Resident later confirms assistance.
    // =========================================================

    match /responseAssignments/{assignmentId} {

      function validVolunteerResponseTransition() {
        return (
          resource.data.status == 'offered'
          && request.resource.data.status in [
            'accepted',
            'declined'
          ]
        )

        || (
          resource.data.status == 'accepted'
          && request.resource.data.status == 'responding'
        )

        || (
          resource.data.status == 'responding'
          && request.resource.data.status == 'on_site'
        )

        || (
          resource.data.status == 'on_site'
          && request.resource.data.status == 'completed'
        );
      }

      function validVolunteerResponseFields() {

        let changed = request.resource.data
          .diff(resource.data)
          .affectedKeys();

        return (
          resource.data.status == 'offered'

          && request.resource.data.status in [
            'accepted',
            'declined'
          ]

          && changed.hasOnly([
            'status',
            'updatedAt'
          ])
        )

        || (
          resource.data.status == 'accepted'

          && request.resource.data.status == 'responding'

          && changed.hasOnly([
            'status',
            'updatedAt',
            'responseStartedAt'
          ])

          && request.resource.data.responseStartedAt is timestamp
        )

        || (
          resource.data.status == 'responding'

          && request.resource.data.status == 'on_site'

          && changed.hasOnly([
            'status',
            'updatedAt',
            'arrivedAt'
          ])

          && request.resource.data.arrivedAt is timestamp
        )

        || (
          resource.data.status == 'on_site'

          && request.resource.data.status == 'completed'

          && changed.hasOnly([
            'status',
            'updatedAt',

            'contributionType',
            'contributionSummary',
            'peopleHelped',
            'completionNotes',

            'completedAt',

            'residentConfirmationStatus'
          ])

          && request.resource.data.contributionType is string
          && request.resource.data.contributionType.size() > 0
          && request.resource.data.contributionType.size() <= 100

          && request.resource.data.contributionSummary is string
          && request.resource.data.contributionSummary.size() >= 10
          && request.resource.data.contributionSummary.size() <= 1200

          && request.resource.data.peopleHelped is int
          && request.resource.data.peopleHelped >= 0
          && request.resource.data.peopleHelped <= 999

          && request.resource.data.completionNotes is string
          && request.resource.data.completionNotes.size() <= 600

          && request.resource.data.completedAt is timestamp

          && request.resource.data.residentConfirmationStatus
            == 'pending'
        );
      }

      function assignmentCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(resource.data.caseId)
        ).data;
      }

      function incomingAssignmentCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      function incomingVolunteerProfile() {
        return get(
          /databases/$(database)/documents/users/$(request.resource.data.volunteerId)
        ).data;
      }

      function incomingVolunteerIsApproved() {
        return incomingVolunteerProfile().role == 'volunteer'
          && (
            (
              'status' in incomingVolunteerProfile()
              && incomingVolunteerProfile().status == 'approved'
            )
            || !('status' in incomingVolunteerProfile())
          );
      }

      allow read: if isAdmin()

        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        )

        || (
          isResident()
          && assignmentCase().reporterUid == request.auth.uid
        );

      // ---------------------------------------------------------
      // ADMIN ASSIGNMENT
      // ---------------------------------------------------------

      allow create: if isAdmin()

        && request.resource.data.keys().hasOnly([
          'caseId',
          'volunteerId',
          'volunteerName',
          'caseTitle',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0

        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerId.size() > 0

        && request.resource.data.volunteerName is string

        && request.resource.data.caseTitle is string

        && request.resource.data.status == 'offered'

        && request.resource.data.createdBy == request.auth.uid

        && exists(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        )

        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.volunteerId)
        )

        // Only a real approved Volunteer account may be assigned.
        && incomingVolunteerIsApproved()

        // The reporter can never be assigned to their own case.
        && incomingAssignmentCase().reporterUid
          != request.resource.data.volunteerId

        // Assign only operationally valid cases.
        && incomingAssignmentCase().status in [
          'validated',
          'assigned',
          'in_progress'
        ]

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isAdmin()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])

        && request.resource.data.status in [
          'offered',
          'accepted',
          'responding',
          'on_site',
          'completed',
          'declined',
          'cancelled'
        ]

        && request.resource.data.updatedAt is timestamp;

      // ---------------------------------------------------------
      // VOLUNTEER RESPONSE LIFECYCLE
      // ---------------------------------------------------------

      allow update: if isVolunteer()

        && resource.data.volunteerId == request.auth.uid

        && request.resource.data.volunteerId
          == resource.data.volunteerId

        && request.resource.data.caseId
          == resource.data.caseId

        // A reporter cannot act as responder on their own case,
        // including any legacy assignment that may already exist.
        && assignmentCase().reporterUid != request.auth.uid

        && validVolunteerResponseTransition()

        && validVolunteerResponseFields()

        && request.resource.data.updatedAt is timestamp;

      // ---------------------------------------------------------
      // RESIDENT CONFIRMATION
      //
      // Full / Partial:
      //   assignment + confirmation + verifiedContribution
      //
      // Not Helped:
      //   assignment + confirmation + dispute
      //
      // All writes must exist in the same writeBatch().
      // ---------------------------------------------------------

      allow update: if isResident()

        && assignmentCase().reporterUid == request.auth.uid

        && resource.data.status == 'completed'

        && request.resource.data.status == resource.data.status

        && request.resource.data.caseId == resource.data.caseId

        && request.resource.data.volunteerId
          == resource.data.volunteerId

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'residentConfirmationStatus',
            'residentConfirmationOutcome',
            'verifiedContributionId',
            'residentConfirmedAt',
            'updatedAt'
          ])

        && request.resource.data.residentConfirmationOutcome in [
          'fully_helped',
          'partially_helped',
          'not_helped'
        ]

        && request.resource.data.residentConfirmedAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && (

          // FULL / PARTIAL
          (
            request.resource.data.residentConfirmationOutcome in [
              'fully_helped',
              'partially_helped'
            ]

            && request.resource.data.residentConfirmationStatus
              == 'resident_confirmed'

            && request.resource.data.verifiedContributionId
              == assignmentId

            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.assignmentId == assignmentId

            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.residentId == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.outcome
              == request.resource.data.residentConfirmationOutcome

            && getAfter(
              /databases/$(database)/documents/verifiedContributions/$(assignmentId)
            ).data.assignmentId == assignmentId

            && getAfter(
              /databases/$(database)/documents/verifiedContributions/$(assignmentId)
            ).data.status == 'verified'
          )

          ||

          // NOT HELPED
          (
            request.resource.data.residentConfirmationOutcome
              == 'not_helped'

            && request.resource.data.residentConfirmationStatus
              == 'disputed'

            && !(
              'verifiedContributionId'
              in request.resource.data
            )

            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.outcome == 'not_helped'

            && getAfter(
              /databases/$(database)/documents/responseDisputes/$(assignmentId)
            ).data.assignmentId == assignmentId
          )
        );

      allow delete: if false;
    }

    // =========================================================
    // RESIDENT ASSISTANCE CONFIRMATION
    // =========================================================

    match /assistanceConfirmations/{assignmentId} {

      function confirmationAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }

      function confirmationCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      allow read: if isAdmin()

        || (
          approved()
          && resource.data.residentId == request.auth.uid
        )

        || (
          isVolunteer()
          && resource.data.volunteerId == request.auth.uid
        );

      allow create: if isResident()

        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',
          'residentId',
          'volunteerId',
          'outcome',
          'reviewState',
          'residentNote',
          'creditStatus',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.assignmentId == assignmentId

        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0

        && request.resource.data.residentId == request.auth.uid

        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerId.size() > 0

        && request.resource.data.outcome in [
          'fully_helped',
          'partially_helped',
          'not_helped'
        ]

        && request.resource.data.residentNote is string
        && request.resource.data.residentNote.size() <= 1000

        && (
          request.resource.data.outcome != 'not_helped'
          || request.resource.data.residentNote.size() >= 10
        )

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp

        && confirmationAssignment().caseId
          == request.resource.data.caseId

        && confirmationAssignment().volunteerId
          == request.resource.data.volunteerId

        // Reporter and responder must be different accounts.
        && request.resource.data.volunteerId
          != request.auth.uid

        && confirmationAssignment().status == 'completed'

        && confirmationCase().reporterUid == request.auth.uid

        && confirmationCase().status in [
          'assigned',
          'in_progress',
          'resolved',
          'closed'
        ]

        && (

          // Full / Partial = credited immediately in the
          // Spark atomic resident confirmation batch.
          (
            request.resource.data.outcome in [
              'fully_helped',
              'partially_helped'
            ]

            && request.resource.data.reviewState
              == 'resident_confirmed'

            && request.resource.data.creditStatus
              == 'credited'

            && getAfter(
              /databases/$(database)/documents/verifiedContributions/$(assignmentId)
            ).data.assignmentId == assignmentId
          )

          ||

          // Not Helped = disputed, not credited.
          (
            request.resource.data.outcome == 'not_helped'

            && request.resource.data.reviewState
              == 'disputed'

            && request.resource.data.creditStatus
              == 'disputed'

            && getAfter(
              /databases/$(database)/documents/responseDisputes/$(assignmentId)
            ).data.assignmentId == assignmentId
          )
        );

      allow update, delete: if false;
    }

    // =========================================================
    // LIVE RESPONDER GPS
    // =========================================================

    match /responseLocations/{uid} {

      function linkedAssignmentForWrite() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }

      function linkedAssignmentForRead() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(resource.data.assignmentId)
        ).data;
      }

      function linkedCaseForRead() {
        return get(
          /databases/$(database)/documents/disasterCases/$(resource.data.caseId)
        ).data;
      }

      function linkedCaseForWrite() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      // Admin, sharing volunteer, and resident who owns the case.
      allow read: if isAdmin()

        || (
          isVolunteer()
          && request.auth.uid == uid
        )

        || (
          isResident()

          && linkedCaseForRead().reporterUid
            == request.auth.uid

          && linkedCaseForRead().status in [
            'assigned',
            'in_progress'
          ]

          && linkedAssignmentForRead().volunteerId
            == resource.data.volunteerId

          && linkedAssignmentForRead().caseId
            == resource.data.caseId

          && linkedAssignmentForRead().status in [
            'responding',
            'on_site'
          ]
        );

      allow create, update: if isVolunteer()

        && request.auth.uid == uid

        && request.resource.data.keys().hasOnly([
          'volunteerId',
          'assignmentId',
          'caseId',
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])

        && request.resource.data.volunteerId == request.auth.uid

        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0

        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0

        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90

        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180

        && (
          request.resource.data.accuracy == null
          || request.resource.data.accuracy is number
        )

        && request.resource.data.updatedAt is timestamp

        && linkedAssignmentForWrite().volunteerId
          == request.auth.uid

        && linkedAssignmentForWrite().caseId
          == request.resource.data.caseId

        // Never publish responder GPS for the reporter's own case.
        && linkedCaseForWrite().reporterUid
          != request.auth.uid

        && linkedAssignmentForWrite().status in [
          'responding',
          'on_site'
        ];

      // Completion automatically stops responder GPS.
      allow delete: if isAdmin()

        || (
          isVolunteer()
          && request.auth.uid == uid
        );
    }

    // =========================================================
    // OPTIONAL RESIDENT LIVE GPS
    // =========================================================

    match /residentResponseLocations/{uid} {

      function residentAssignmentForWrite() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(request.resource.data.assignmentId)
        ).data;
      }

      function residentCaseForWrite() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
      }

      function residentAssignmentForRead() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(resource.data.assignmentId)
        ).data;
      }

      function residentCaseForRead() {
        return get(
          /databases/$(database)/documents/disasterCases/$(resource.data.caseId)
        ).data;
      }

      function validResidentLocationPayload() {
        return request.resource.data.keys().hasOnly([
          'residentId',
          'assignmentId',
          'caseId',
          'latitude',
          'longitude',
          'accuracy',
          'updatedAt'
        ])

        && request.resource.data.residentId == request.auth.uid

        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0

        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0

        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90

        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180

        && (
          request.resource.data.accuracy == null
          || request.resource.data.accuracy is number
        )

        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isAdmin()

        || (
          isResident()
          && request.auth.uid == uid
          && resource.data.residentId == request.auth.uid
        )

        || (
          isVolunteer()

          && residentAssignmentForRead().volunteerId
            == request.auth.uid

          && residentAssignmentForRead().caseId
            == resource.data.caseId

          && residentAssignmentForRead().status in [
            'accepted',
            'responding',
            'on_site'
          ]

          && residentCaseForRead().reporterUid
            == resource.data.residentId

          && residentCaseForRead().status in [
            'assigned',
            'in_progress'
          ]
        );

      allow create: if isResident()

        && request.auth.uid == uid

        && validResidentLocationPayload()

        && residentCaseForWrite().reporterUid
          == request.auth.uid

        && residentCaseForWrite().status in [
          'assigned',
          'in_progress'
        ]

        && residentAssignmentForWrite().caseId
          == request.resource.data.caseId

        && residentAssignmentForWrite().status in [
          'accepted',
          'responding',
          'on_site'
        ];

      // Resident may refresh the same mission OR switch this single
      // live-location document to a new active mission that they own.
      // This prevents an old caseId / assignmentId from blocking
      // live sharing on the resident's next emergency response.
      allow update: if isResident()

        && request.auth.uid == uid

        && resource.data.residentId == request.auth.uid

        && validResidentLocationPayload()

        && residentCaseForWrite().reporterUid
          == request.auth.uid

        && residentCaseForWrite().status in [
          'assigned',
          'in_progress'
        ]

        && residentAssignmentForWrite().caseId
          == request.resource.data.caseId

        && residentAssignmentForWrite().status in [
          'accepted',
          'responding',
          'on_site'
        ];

      // Resident can always stop sharing.
      allow delete: if isAdmin()

        || (
          isResident()
          && request.auth.uid == uid
          && resource.data.residentId == request.auth.uid
        );
    }

    // =========================================================
    // ADMIN LOGS
    // =========================================================

    // Operational Admins may write immutable audit entries.
    // Only Super Admin may review the global audit trail.
    match /adminLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminActivityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================
    // AI MAP RECORDS
    //
    // Functions are not part of the required Spark demo flow.
    // Existing records remain Admin-readable.
    // =========================================================

    match /aiMapBriefings/{briefingId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /aiMapRateLimits/{uid} {
      allow read, write: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}