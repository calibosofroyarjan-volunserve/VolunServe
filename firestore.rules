              'partially_helped'
            ]
            && request.resource.data.residentConfirmationStatus
              == 'resident_confirmed'
            && request.resource.data.verifiedContributionId
              == assignmentId
            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.assignmentId == assignmentId
            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.residentId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.outcome
              == request.resource.data.residentConfirmationOutcome
            && getAfter(
              /databases/$(database)/documents/verifiedContributions/$(assignmentId)
            ).data.assignmentId == assignmentId
            && getAfter(
              /databases/$(database)/documents/verifiedContributions/$(assignmentId)
            ).data.status == 'verified'
          )
          ||
          (
            request.resource.data.residentConfirmationOutcome
              == 'not_helped'
            && request.resource.data.residentConfirmationStatus
              == 'disputed'
            && !(
              'verifiedContributionId'
              in request.resource.data
