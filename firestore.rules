            'residentConfirmedAt',
            'updatedAt'
          ])
        && request.resource.data.residentConfirmationOutcome in [
          'fully_helped',
          'partially_helped',
          'not_helped'
        ]
        && request.resource.data.residentConfirmedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.residentConfirmationOutcome in [
