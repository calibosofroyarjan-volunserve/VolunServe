          'incorporated',
          'dismissed'
        ]
        && request.resource.data.adminReviewNote is string
        && request.resource.data.adminReviewNote.size() <= 1500
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /assistanceConfirmations/{assignmentId} {
      function confirmationAssignment() {
        return get(
          /databases/$(database)/documents/responseAssignments/$(assignmentId)
        ).data;
      }
      function confirmationCase() {
        return get(
          /databases/$(database)/documents/disasterCases/$(request.resource.data.caseId)
        ).data;
