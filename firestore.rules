          'caseId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.responderUid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.caseId is string
        && request.resource.data.caseId.size() > 0
        && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt is timestamp
        && lockTargetsMatch('accepted');
      allow update: if isVolunteer()
        && request.auth.uid == uid
        && resource.data.responderUid == request.auth.uid
        && request.resource.data.responderUid == resource.data.responderUid
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.keys().hasOnly([
          'responderUid',
          'assignmentId',
          'caseId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status in [
