            && getAfter(
              /databases/$(database)/documents/assistanceConfirmations/$(assignmentId)
            ).data.outcome == 'not_helped'
            && getAfter(
              /databases/$(database)/documents/responseDisputes/$(assignmentId)
            ).data.assignmentId == assignmentId
          )
        );
      allow delete: if false;
    }
    match /volunteerFieldReports/{assignmentId} {
      function fieldReportAssignmentAfter() {
