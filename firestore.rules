      allow create: if isVolunteer()
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'caseId',
          'volunteerId',
          'volunteerName',
          'barangay',
          'situationSummary',
          'assistanceProvided',
          'peopleHelped',
          'remainingNeeds',
          'remainingNeedsNote',
